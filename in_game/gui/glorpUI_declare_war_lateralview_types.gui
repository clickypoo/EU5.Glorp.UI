types GlorpUIWarGoals {
    type overlord_cards = vbox {
        spacing = 5
        widget = {
            size = {230 55}
            vbox = {
                layoutpolicy_horizontal = expanding
                using = bg_paper_card_fancy
                block "joining_countries_card_tooltip" {}

                joining_countries_button_header = {
                    visible = "[Not(Or(DeclareWarAlly.IsSubject, And(Not(DeclareWarAlly.IsCallAllyEnabled), DeclareWarAlly.IsCallAllyAutoJoin)))]"
                }
                joining_countries_card_header = {
                    visible = "[Or(DeclareWarAlly.IsSubject, And(Not(DeclareWarAlly.IsCallAllyEnabled), DeclareWarAlly.IsCallAllyAutoJoin))]"
                }

                widget = {
                    layoutpolicy_horizontal = expanding
                    size = { -1 25 }

                    hbox = {
                        margin = { 5 0 }
                        text_single = {
                            size = {70 20}
                            autoresize = no
                            align = center|nobaseline
                            raw_text = "[DeclareWarAlly.GetLandStrength]@army_strength!"
                        }

                        divider_flavor_01 = {
                            blockoverride "divider_margin" {}
                            size = {9 -1}
                        }

                        text_single = {
                            size = {70 20}
                            autoresize = no
                            align = center|nobaseline
                            raw_text = "[DeclareWarAlly.GetCountry.GetTotalShips]@navy_strength!"
                        }

                        divider_flavor_01 = {
                            block "joining_countries_declare_war_show_promise_land" {
                                visible = "[Not(DeclareWarAlly.IsSubject)]"
                            }
                            blockoverride "divider_margin" {}
                            size = {9 -1}
                        }

                        widget = {
                            layoutpolicy_vertical = expanding
                            size = { 40 -1 }

                            icon = {
                                block "joining_countries_declare_war_show_promise_land" {
                                    visible = "[Not(DeclareWarAlly.IsSubject)]"
                                }
                                parentanchor = left|vcenter
                                size = {20 20}
                                texture = "gfx/interface/icons/flat_icons/declare_war/antagonism.dds"
                            }

                            widget = {
                                parentanchor = right|vcenter
                                size = { 19 19 }
                                # Avoiding assert when checking relations and also simplifying code in checkboxes
                                # Use the same visible as for call ally as they are always together
                                block "joining_countries_declare_war_show_promise_land" {
                                    visible = "[Not(DeclareWarAlly.IsSubject)]"
                                }

                                # Enabled checkboxes
                                button_checkbox = {
                                    parentanchor = center
                                    size = { 19 19 }
                                    enabled = "[DeclareWarAlly.IsPromiseLandEnabled]"

                                    tooltipwidget = {
                                        SimpleContextualTooltipType = {
                                            blockoverride "title_icon" {
                                                country_flag_small = {
                                                    datacontext = "[DeclareWarAlly.GetCountry]"
                                                }
                                            }
                                            blockoverride "title_text" {
                                                text = "[DeclareWarAlly.GetCountry.GetLongNameWithNoTooltip]"
                                            }
                                            blockoverride "concept_link" {
                                                text = [call_to_arms|e]
                                            }
                                            lowpriotextcontext = "[DeclareWarAlly.GetPromiseLandTooltip]"
                                            blockoverride "tooltip_extra_content" {
                                                TooltipFunctionalBlock = {
                                                    using = tooltip_left_click_template

                                                    blockoverride "action_left_text" {
                                                        text = "PROMISE_LAND"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    checked = "[DeclareWarAlly.IsPromiseLandChecked]"
                                    onclick = "[DeclareWarAlly.OnPromiseLandClick]"
                                }
                            }
                        }

                        expand = {}
                    }
                }
            }
        }

        vbox = {
            visible = "[And(DeclareWarAlly.HasSubjectAllies, DeclareWarAlly.IsExpanded)]"
            datamodel = "[DeclareWarAlly.GetSubjectAllies]"
            spacing = 5
            item = {
                recursive = yes
                vbox = {
                    overlord_cards = {
                        visible = "[DeclareWarAlly.HasSubjectAllies]"
                    }

                    not_overlord_cards = {}
                }
            }
        }
    }

    type not_overlord_cards = widget {
        block "joining_countries_declare_war_exclude_not_overlords" {
            visible = "[Not(DeclareWarAlly.HasSubjectAllies)]"
        }
        size = {230 55}
        vbox = {
            layoutpolicy_horizontal = expanding
            using = bg_paper_card_fancy
            block "joining_countries_card_tooltip" {}

            joining_countries_button_header = {
                visible = "[Not(Or(DeclareWarAlly.IsSubject, And(Not(DeclareWarAlly.IsCallAllyEnabled), DeclareWarAlly.IsCallAllyAutoJoin)))]"
            }
            joining_countries_card_header = {
                visible = "[Or(DeclareWarAlly.IsSubject, And(Not(DeclareWarAlly.IsCallAllyEnabled), DeclareWarAlly.IsCallAllyAutoJoin))]"
            }

            widget = {
                layoutpolicy_horizontal = expanding
                size = { -1 25 }

                hbox = {
                    margin = { 5 0 }
                    text_single = {
                        size = {70 20}
                        autoresize = no
                        align = center|nobaseline
                        raw_text = "[DeclareWarAlly.GetLandStrength]@army_strength!"
                    }

                    divider_flavor_01 = {
                        blockoverride "divider_margin" {}
                        size = {9 -1}
                    }

                    text_single = {
                        size = {70 20}
                        autoresize = no
                        align = center|nobaseline
                        raw_text = "[DeclareWarAlly.GetCountry.GetTotalShips]@navy_strength!"
                    }

                    divider_flavor_01 = {
                        block "joining_countries_declare_war_show_promise_land" {
                            visible = "[Not(DeclareWarAlly.IsSubject)]"
                        }
                        blockoverride "divider_margin" {}
                        size = {9 -1}
                    }

                    widget = {
                        layoutpolicy_vertical = expanding
                        size = { 67 -1 }

                        hbox = {
                            expand = {}

                            icon = {
                                block "joining_countries_declare_war_show_promise_land" {
                                    visible = "[Not(DeclareWarAlly.IsSubject)]"
                                }
                                size = {18 18}
                                texture = "[GetConceptTexture('area')]"
                            }

                            widget = {
                                size = { 19 19 }
                                # Avoiding assert when checking relations and also simplifying code in checkboxes
                                # Use the same visible as for call ally as they are always together
                                block "joining_countries_declare_war_show_promise_land" {
                                    visible = "[Not(DeclareWarAlly.IsSubject)]"
                                }

                                # Enabled checkboxes
                                button_checkbox = {
                                    size = { 19 19 }
                                    enabled = "[DeclareWarAlly.IsPromiseLandEnabled]"

                                    tooltipwidget = {
                                        SimpleContextualTooltipType = {
                                            blockoverride "title_icon" {
                                                country_flag_small = {
                                                    datacontext = "[DeclareWarAlly.GetCountry]"
                                                }
                                            }
                                            blockoverride "title_text" {
                                                text = "[DeclareWarAlly.GetCountry.GetLongNameWithNoTooltip]"
                                            }
                                            blockoverride "concept_link" {
                                                text = [call_to_arms|e]
                                            }
                                            lowpriotextcontext = "[DeclareWarAlly.GetPromiseLandTooltip]"
                                            blockoverride "tooltip_extra_content" {
                                                TooltipFunctionalBlock = {
                                                    using = tooltip_left_click_template

                                                    blockoverride "action_left_text" {
                                                        text = "PROMISE_LAND"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    checked = "[DeclareWarAlly.IsPromiseLandChecked]"
                                    onclick = "[DeclareWarAlly.OnPromiseLandClick]"
                                }
                            }
                            expand = {}
                        }
                    }
                }
            }
        }
    }

    type declare_war_comparisson = text_single {
        block "declare_war_comparison_visible" {}
        margin = {15 5}
        background = {
            texture = "gfx/interface/component_tiles/circle_container_flat.dds"
            mirror = horizontal
            texture_density = 2
            spriteType = corneredstretched
            spriteBorder = { 16 0 }
            alpha = 1

            modify_texture = {
                using = color_bg_brown_texture
            }
            modify_texture = {
                using = overlay_striped_texture
                blend_mode = overlay
                alpha = 0.2
            }
            modify_texture = {
                texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_solid.dds"
                blend_mode = multiply
                alpha = 0.4
            }
        }
        default_format = "#yellow_titles"
        align = nobaseline
        fontsize = 14
        using = FontDefaultColor
        block "declare_war_comparison_text" {
            raw_text = " "
        }
        icon = {
            parentanchor = center
            position = {0 -3}
            size = {107% 100%}
            using = baroque_corner_flavor_01
        }
    }

    type joining_countries_button_header = button {
        layoutpolicy_horizontal = expanding
        size = { -1 30 }
        using = bg_card_header_01

        using = color_black_texture
        texture_density = 2

        modify_texture = {
            block "joining_countries_declare_war_ally_color" {
                visible = "[Not(DeclareWarAlly.IsSubject)]"
                using = color_low_green_texture
                alpha = 0.7
            }
        }

        modify_texture = {
            block "joining_countries_declare_war_enemy_color" {
                visible = no
                using = color_dark_red_texture
                alpha = 0.8
            }
        }

        modify_texture = {
            visible = "[DeclareWarAlly.IsSubject]"
            using = color_low_green_texture
            alpha = 0.7
        }

        modify_texture = {
            texture = "[GetGraphicalCultureTexture('header_pattern')]"
            texture_density = 2.3
            spriteType = corneredtiled
            blend_mode = overlay
            alpha = 0.7
        }

        modify_texture = {
            texture = "gfx/interface/component_overlay/cloth_texture.dds"
            texture_density = 2
            spriteType = Corneredtiled
            spriteborder = { 0 0 }
            blend_mode = overlay
            alpha = 0.2
        }

        icon = {
            size = {100% 100%}
            texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
            alpha = 0.2
            modify_texture = {
                texture = "gfx/interface/colors/clergy.dds"
                blend_mode = multiply
            }
        }

        hbox = {
            ignoreinvisible = yes
            margin_right = 5

            widget = {
                layoutpolicy_horizontal = expanding
                size = { -1 30 }
                hbox = {
                    margin = { -1 1 }
                    spacing = 4

                    country_flag_small = {
                        blockoverride "country_flag_small_size" {size = { 42 28 }}
                        datacontext = "[DeclareWarAlly.GetCountry]"
                    }

                    text_single = {
                        maximumsize = {80 20}
                        text = "[DeclareWarAlly.GetCountry.GetName]"
                    }

                    expand = {}

                    widget = {
                        size = { 29 29 }

                        visible = "[DeclareWarAlly.HasTruceWithEnemyLeader]"

                        piechart = {
                            visible = "[DeclareWarAlly.HasTruceWithEnemyLeader]"
                            parentanchor = center

                            size = { 90% 90% }

                            using = piechart_angles

                            icon = {
                                texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
                                size = { 97% 97% }
                                parentanchor = center
                                color = { 0.45 0.59  0.67 1 }
                                alpha = 0.3
                            }

                            pieslice = {
                                texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
                                value = "[DeclareWarAlly.GetTruceProgress]"
                                color = { 0.01 0.6 0.9 1 }
                            }

                            pieslice = {
                                texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
                                value = "[Subtract_float('(float)100.0', DeclareWarAlly.GetTruceProgress)]"
                                color = { 1 1 1 0 }
                            }
                        }

                        icon = {
                            size = { 80% 80% }
                            visible = "[DeclareWarAlly.HasTruceWithEnemyLeader]"
                            texture = "gfx/interface/icons/diplomatic_status/truce.dds"
                            parentanchor = center

                            tooltipwidget = {
                                BasicFunctionalTooltip = {
                                    blockoverride "tooltip_content" {
                                        TooltipTextBlock = {
                                            blockoverride "text" {
                                                text = "[SelectLocalization(ObjectsEqual(DeclareWarAlly.GetSideLeader, Player.Self), 'CANT_BREAK_COBELLIGERENT_TRUCE', 'BREAKING_COBELLIGERENT_TRUCE')]"
                                            }

                                            blockoverride "textblock_background_tint"  {
                                                modify_texture = {
                                                    using = color_dark_red_texture
                                                    alpha = 0.8
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    # icon = {
                    # 	position = { -10 0 }
                    # 	allow_outside = yes
                    # 	size = {20 20}
                    # 	visible = "[And3(Not(DeclareWarAlly.IsSubject), DeclareWarAlly.WillJoinBecauseOfLandPromised, Not(DeclareWarAlly.GetCountry.HasHumanController))]"
                    # 	texture = "[GetConceptTexture('area')]"
                    # 	tooltipwidget = {
                    # 		SimpleContextualTooltipType = {
                    # 			blockoverride "title_icon" {
                    # 				country_flag_small = {
                    # 					datacontext = "[DeclareWarAlly.GetCountry]"
                    # 				}
                    # 			}
                    # 			blockoverride "title_text" {
                    # 				text = "[DeclareWarAlly.GetCountry.GetLongNameWithNoTooltip]"
                    # 			}
                    # 			blockoverride "concept_link" {
                    # 				text = [call_to_arms|e]
                    # 			}

                    # 			lowpriotextcontext = "WILL_ACCEPT_PROMISE_LAND"
                    # 		}
                    # 	}
                    # }

                    icon = {
                        size = {23 23}
                        visible = "[Or(DeclareWarAlly.IsSubject, And3(DeclareWarAlly.IsCallAllyCheckedOrAutoJoined,DeclareWarAlly.WillJoinIfCalled, Not(DeclareWarAlly.GetCountry.HasHumanController)))]"

                        framesize = { 47 46 }
                        texture = "gfx/interface/icons/diplomatic_status/ai_accept_decline_icon.dds"
                        frame = 2
                    }

                    icon = {
                        size = {23 23}
                        visible = "[And(Not(DeclareWarAlly.IsSubject), DeclareWarAlly.GetCountry.HasHumanController)]"

                        framesize = { 46 46 }
                        texture = "gfx/interface/icons/diplomatic_status/ai_accept_decline_icon.dds"
                        frame = 3
                    }

                    icon = {
                        size = {23 23}
                        visible = "[And3(Not(DeclareWarAlly.IsSubject), Not(DeclareWarAlly.WillJoinIfCalled), Not(DeclareWarAlly.GetCountry.HasHumanController))]"

                        icon = {
                            parentanchor = left|bottom
                            position = { -8 0}
                            size = {13 13}
                            visible = "[And3(Not(DeclareWarAlly.IsSubject), DeclareWarAlly.WillJoinBecauseOfLandPromised, Not(DeclareWarAlly.GetCountry.HasHumanController))]"
                            texture = "[GetConceptTexture('area')]"
                        }

                        framesize = { 47 46 }
                        texture = "gfx/interface/icons/diplomatic_status/ai_accept_decline_icon.dds"
                        frame = 1
                    }

                    # IS AUTOJOIN
                    icon = {
                        size = { 19 19 }
                        visible = "[DeclareWarAlly.IsSubject]"
                        texture = "gfx/interface/icons/treaty_type/become_subject.dds"

                        glow = {
                            name = "drop_shadow"
                            glow_radius = 3
                            color = {0.0 0.0 0.0 1.0}
                            alpha = 0.3
                        }
                    }

                    # call into the war
                    widget = {
                        size = { 21 21 }
                        # Avoiding assert when checking relations and also simplifying code in checkboxes
                        visible = "[And(Not(DeclareWarAlly.IsOriginalLeader), DeclareWarAlly.IsCallAllyVisible)]"

                        # Enabled checkboxes
                        button_checkbox_alt = {
                            size = { 21 21 }
                            visible = "[DeclareWarAlly.IsCallAllyVisible]"
                            enabled = "[DeclareWarAlly.IsCallAllyEnabled]"

                            tooltipwidget = {
                                SimpleContextualTooltipType = {
                                    blockoverride "title_icon" {
                                        country_flag_small = {
                                            datacontext = "[DeclareWarAlly.GetCountry]"
                                        }
                                    }

                                    blockoverride "tooltip_content" {
                                        TooltipBlockList = {
                                            visible = "[Not(DeclareWarAlly.GetCountry.HasHumanController)]"
                                            textcontext = "[DeclareWarAlly.GetAreWillingToJoinTooltip]"
                                        }

                                        TooltipTextBlock = {
                                            visible = "[DeclareWarAlly.HasTruceWithEnemyLeader]"

                                            blockoverride "text" {
                                                text = "[SelectLocalization(ObjectsEqual(DeclareWarAlly.GetSideLeader, Player.Self), 'CANT_BREAK_COBELLIGERENT_TRUCE', 'BREAKING_COBELLIGERENT_TRUCE')]"
                                            }

                                            blockoverride "textblock_background_tint"  {
                                                modify_texture = {
                                                    using = color_dark_red_texture
                                                    alpha = 0.8
                                                }
                                            }
                                        }
                                        TooltipTextBlock = {
                                            visible = "[DeclareWarAlly.GetCountry.HasHumanController]"
                                            blockoverride "text" {
                                                text = "HUMAN_PLAYER_RESPONSE"
                                            }
                                            blockoverride "textblock_background_tint"  {
                                                modify_texture = {
                                                    using = color_yellow_texture
                                                }
                                            }
                                        }
                                    }

                                    blockoverride "title_text" {
                                        text = "[DeclareWarAlly.GetCountry.GetLongNameWithNoTooltip]"
                                    }
                                    blockoverride "concept_link" {
                                        text = [call_to_arms|e]
                                    }
                                }
                            }
                            checked = "[DeclareWarAlly.IsCallAllyCheckedOrAutoJoined]"
                            onclick = "[DeclareWarAlly.OnCallAllyClick]"
                            onmousehierarchyenter = "[PdxGuiWidget.SetHighlightCountry( DeclareWarAlly.GetCountry )]"
                        }
                    }

                    # expand subjects
                    widget = {
                        size = { 21 21 }
                        # Avoiding assert when checking relations and also simplifying code in checkboxes
                        visible = "[DeclareWarAlly.HasSubjectAllies]"

                        # Enabled checkboxes
                        button = {
                            icon = {
                                size = { 21 21 }
                                visible = "[Not(DeclareWarAlly.IsExpanded)]"
                                texture = "gfx/interface/buttons/flats/button_simple_right.dds"
                                using = button_regular_icon_color
                            }

                            icon = {
                                size = { 21 21 }
                                visible = "[DeclareWarAlly.IsExpanded]"
                                texture = "gfx/interface/buttons/flats/button_simple_down.dds"
                                using = button_regular_icon_color
                            }

                            size = { 100% 100% }
                            onclick = "[DeclareWarAlly.ToggleExpanded]"
                            action_tooltip = { title = "OUTLINER_SETTINGS_TOGGLE_TOOLTIP" }
                            tooltipwidget = { BasicFunctionalTooltip = {} }
                        }
                    }
                }
            }
        }

        action_tooltip = {
            click_type = left
            click_mode = single
            title = "game_concept_call_to_arms"
            enabled = "[DeclareWarAlly.IsCallAllyEnabled]"
            description = "[DeclareWarAlly.GetAreWillingToJoinTooltip]"
            on_action = "[DeclareWarAlly.OnCallAllyClick]"
            visible = "[And(Not(DeclareWarAlly.IsOriginalLeader), DeclareWarAlly.IsCallAllyVisible)]"
        }

        tooltipwidget = {
            SimpleContextualTooltipType = {
                datacontext = "[DeclareWarAlly.GetCountry]"
                blockoverride "title_icon" {
                    country_flag_small = {
                        datacontext = "[DeclareWarAlly.GetCountry]"
                    }
                }
                blockoverride "title_text" {
                    text = "[DeclareWarAlly.GetCountry.GetLongNameWithNoTooltip]"
                }
                blockoverride "concept_link" {
                    text = [call_to_arms|e]
                }
                blockoverride "tooltip_content" {
                    TooltipStringPairList = {
                        visible = "[Not(DeclareWarAlly.GetCountry.HasHumanController)]"
                        textcontext = "[DeclareWarAlly.GetAreWillingToJoinTooltip]"
                    }

                    TooltipTextBlock = {
                        visible = "[DeclareWarAlly.HasTruceWithEnemyLeader]"

                        blockoverride "text" {
                            text = "[SelectLocalization(ObjectsEqual(DeclareWarAlly.GetSideLeader, Player.Self), 'CANT_BREAK_COBELLIGERENT_TRUCE', 'BREAKING_COBELLIGERENT_TRUCE')]"
                        }

                        blockoverride "textblock_background_tint"  {
                            modify_texture = {
                                using = color_dark_red_texture
                                alpha = 0.8
                            }
                        }
                    }
                    TooltipTextBlock = {
                        visible = "[DeclareWarAlly.GetCountry.HasHumanController]"
                        blockoverride "text" {
                            text = "HUMAN_PLAYER_RESPONSE"
                        }
                        blockoverride "textblock_background_tint"  {
                            modify_texture = {
                                using = color_yellow_texture
                            }
                        }
                    }
                    TooltipTextBlock = {
                        visible = "[And3(Not(DeclareWarAlly.IsSubject), DeclareWarAlly.WillJoinBecauseOfLandPromised, Not(DeclareWarAlly.GetCountry.HasHumanController))]"
                        blockoverride "text" {
                            text = "WILL_ACCEPT_PROMISE_LAND"
                        }
                        blockoverride "textblock_background_tint"  {
                            modify_texture = {
                                using = color_light_green_texture
                            }
                        }
                    }
                }
            }
        }

        onmousehierarchyenter = "[PdxGuiWidget.SetHighlightCountry( DeclareWarAlly.GetCountry )]"
        enabled = "[DeclareWarAlly.IsCallAllyEnabled]"
    }

    type joining_countries_card_header = widget {
        layoutpolicy_horizontal = expanding
        size = { -1 30 }

        using = bg_card_header_01

        blockoverride "bg_card_header_01_bg" {
            background = {
                using = color_black_texture
                texture_density = 2

                modify_texture = {
                    block "joining_countries_declare_war_ally_color" {
                        visible = "[Not(DeclareWarAlly.IsSubject)]"
                        using = color_low_green_texture
                        alpha = 0.7
                    }
                }

                modify_texture = {
                    visible = "[DeclareWarAlly.IsPromiseLandVisible]"
                    using = color_low_green_texture
                    alpha = 0.7
                }

                modify_texture = {
                    visible = "[Not(DeclareWarAlly.IsPromiseLandVisible)]"
                    using = color_dark_red_texture
                    alpha = 0.8
                }

                modify_texture = {
                    texture = "[GetGraphicalCultureTexture('header_pattern')]"
                    texture_density = 2.3
                    spriteType = corneredtiled
                    blend_mode = overlay
                    alpha = 0.7
                }
                modify_texture = {
                    texture = "gfx/interface/component_overlay/cloth_texture.dds"
                    texture_density = 2
                    spriteType = Corneredtiled
                    spriteborder = { 0 0 }
                    blend_mode = overlay
                    alpha = 0.2
                }
            }
            background = {
                texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
                # mirror = horizontal
                alpha = 0.2
                modify_texture = {
                    texture = "gfx/interface/colors/clergy.dds"
                    blend_mode = multiply
                }
            }
        }

        hbox = {
            ignoreinvisible = yes
            margin_right = 5

            widget = {
                layoutpolicy_horizontal = expanding
                size = { -1 30 }
                hbox = {
                    margin = { -1 1 }
                    spacing = 4

                    country_flag_small = {
                        blockoverride "country_flag_small_size" {size = { 42 28 }}
                        datacontext = "[DeclareWarAlly.GetCountry]"
                        tooltipwidget = {
                            using = CountryTooltip
                        }
                    }

                    text_single = {
                        maximumsize = {80 20}
                        text = "[DeclareWarAlly.GetCountry.GetName]"
                    }

                    expand = {}

                    icon = {
                        size = {23 23}
                        visible = "[And3(DeclareWarAlly.GetCountry.GetDiplomacy.GetOverlord.HasHumanController, Not(DeclareWarAlly.GetCountry.GetDiplomacy.GetOverlord.IsPlayer), Or(DeclareWarAlly.IsCallAllyAutoJoin, DeclareWarAlly.WillJoinIfCalled))]"

                        framesize = { 46 46 }
                        texture = "gfx/interface/icons/diplomatic_status/ai_accept_decline_icon.dds"
                        frame = 3
                    }

                    icon = {
                        size = {23 23}
                        visible = "[And(Or(Not(DeclareWarAlly.GetCountry.GetDiplomacy.GetOverlord.HasHumanController), DeclareWarAlly.GetCountry.GetDiplomacy.GetOverlord.IsPlayer), Or(DeclareWarAlly.IsCallAllyAutoJoin, DeclareWarAlly.WillJoinIfCalled))]"

                        framesize = { 47 46 }
                        texture = "gfx/interface/icons/diplomatic_status/ai_accept_decline_icon.dds"
                        frame = 2
                    }

                    icon = {
                        size = {23 23}
                        visible = "[And(Not(DeclareWarAlly.IsCallAllyAutoJoin), Not(DeclareWarAlly.WillJoinIfCalled))]"

                        framesize = { 47 46 }
                        texture = "gfx/interface/icons/diplomatic_status/ai_accept_decline_icon.dds"
                        frame = 1
                    }

                    # IS AUTOJOIN
                    icon = {
                        size = { 19 19 }
                        visible = "[DeclareWarAlly.IsSubject]"
                        texture = "gfx/interface/icons/treaty_type/become_subject.dds"

                        glow = {
                            name = "drop_shadow"
                            glow_radius = 3
                            color = {0.0 0.0 0.0 1.0}
                            alpha = 0.3
                        }

                        using = bg_circle_piechart

                    }

                    # call into the war
                    widget = {
                        size = { 21 21 }
                        # Avoiding assert when checking relations and also simplifying code in checkboxes
                        visible = "[And(Not(DeclareWarAlly.IsOriginalLeader), DeclareWarAlly.IsCallAllyVisible)]"

                        # Enabled checkboxes
                        button_checkbox_alt = {
                            size = { 21 21 }
                            visible = "[DeclareWarAlly.IsCallAllyVisible]"
                            enabled = "[DeclareWarAlly.IsCallAllyEnabled]"

                            tooltipwidget = {
                                SimpleContextualTooltipType = {
                                    blockoverride "title_icon" {
                                        country_flag_small = {
                                            datacontext = "[DeclareWarAlly.GetCountry]"
                                        }
                                    }
                                    blockoverride "title_text" {
                                        text = "[DeclareWarAlly.GetCountry.GetLongNameWithNoTooltip]"
                                    }
                                    blockoverride "concept_link" {
                                        text = [call_to_arms|e]
                                    }

                                    blockoverride "tooltip_content" {
                                        TooltipStringPairList = {
                                            textcontext = "[DeclareWarAlly.GetAreWillingToJoinTooltip]"
                                        }
                                    }
                                }
                            }
                            checked = "[DeclareWarAlly.IsCallAllyCheckedOrAutoJoined]"
                            onclick = "[DeclareWarAlly.OnCallAllyClick]"
                            onmousehierarchyenter = "[PdxGuiWidget.SetHighlightCountry( DeclareWarAlly.GetCountry )]"
                        }
                    }

                    # expand subjects
                    widget = {
                        size = { 19 19 }
                        # Avoiding assert when checking relations and also simplifying code in checkboxes
                        visible = "[DeclareWarAlly.HasSubjectAllies]"

                        # Enabled checkboxes
                        widget = {
                            size = { 100% 100% }

                            button = {
                                size = { 100% 100% }
                                visible = "[Not(DeclareWarAlly.IsExpanded)]"
                                texture = "gfx/interface/buttons/flats/button_simple_right.dds"
                                onclick = "[DeclareWarAlly.ToggleExpanded]"
                                using = button_regular_icon_color
                                action_tooltip = { title = "OUTLINER_SETTINGS_TOGGLE_TOOLTIP" }
                                tooltipwidget = { BasicFunctionalTooltip = {} }
                                glow = {
                                    name = "drop_shadow"
                                    glow_radius = 3
                                    color = {0.0 0.0 0.0 1.0}
                                    alpha = 0.3
                                }
                            }

                            button = {
                                size = { 100% 100% }
                                visible = "[DeclareWarAlly.IsExpanded]"
                                texture = "gfx/interface/buttons/flats/button_simple_down.dds"
                                onclick = "[DeclareWarAlly.ToggleExpanded]"
                                using = button_regular_icon_color
                                action_tooltip = { title = "OUTLINER_SETTINGS_TOGGLE_TOOLTIP" }
                                tooltipwidget = { BasicFunctionalTooltip = {} }
                                glow = {
                                    name = "drop_shadow"
                                    glow_radius = 3
                                    color = {0.0 0.0 0.0 1.0}
                                    alpha = 0.3
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

