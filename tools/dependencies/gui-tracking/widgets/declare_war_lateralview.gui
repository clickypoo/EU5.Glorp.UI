								}
			
								icon = {
									texture = "gfx/interface/icons/diplomatic_status/truce.dds"
									size = { 65% 65% }
									parentanchor = center
								}
			
								tooltipwidget = {
									ContextualTooltipType = {
										blockoverride "title_icon" {
											icon = {
												size = { 50 50 }
												texture = "gfx/interface/icons/diplomatic_status/truce.dds"
