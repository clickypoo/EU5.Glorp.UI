															# text = "[DeclareWarLateralView.GetSelectedCasusBelli.GetNameWithNoTooltip]"
															text = "[DeclareWarLateralView.GetSelectedWarGoal.GetCasusBelli.GetNameWithNoTooltip]"
															default_format = "#L"
														}

														hbox = {
															using = layoutpolicy_expanding
