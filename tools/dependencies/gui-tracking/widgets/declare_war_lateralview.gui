															color = {0.0 0.0 0.0 1.0}
															alpha = 0.6
														}
													}
													vbox = {
														margin = { 0 3 }
														visible = "[Not(DeclareWarLateralView.IsAnyCasusBelliSelected)]"
														using = layoutpolicy_expanding
										
														text_single = {
