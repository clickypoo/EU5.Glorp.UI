# vanilla: in_game/gui/outliner_entries.gui
# mod: in_game/gui/outliner_entries.gui

OutlinerEntryBase = {
	name = "expedition_entry"

	blockoverride "expanded_big_content" {
		OutlinerButtonBase = {
			size = { 95% 100% }

			hbox = {
				using = outliner_entry_margin
				spacing = 4

				portrait_standard_head_cached_button = {
					datacontext = "[Expedition.GetLeader]"
					size = { 28 28 }

					blockoverride "character_tooltip" {
						tooltipwidget = {
							BasicFunctionalTooltip = {}
						}
					}

					blockoverride "character_contextmenu" {}
					blockoverride "button_setup" {}
					blockoverride "rightclick" {}
				}

				icon = {
					size = { 20 20 }
					texture = "[Expedition.GetType.GetIcon]"
				}

				OutlinerTextBase = {
					using = layoutpolicy_expanding
					autoresize = no
					align = left
					text = "[Expedition.GetNameWithNoTooltip]"
					default_format = "#L"
				}

				OutlinerTextBase = {
					autoresize = yes
					text = "[Expedition.GetCurrentLocation.GetNameWithNoTooltip]"
				}
			}
		}
	}

	blockoverride "expanded_small_content" {
		OutlinerButtonBase = {
			size = { 95% 100% }

			OutlinerTextBase = {
				size = { 100% 100% }
				using = outliner_entry_margin
				autoresize = no
				align = right
				text = "[Expedition.GetCurrentLocation.GetNameWithNoTooltip]"
			}
		}
	}

	blockoverride "icon_content" {
		OutlinerIconBg = {
			icon = {
				parentanchor = center
				size = { 76% 76% }
				texture = "[Expedition.GetType.GetIcon]"
			}
		}
	}

	blockoverride "button_setup" {
		tooltipwidget = {
			using = Expedition_tooltip
		}
		action_tooltip = {
			click_type = left
			click_mode = single
			title = "OUTLINER_OPEN_EXPEDITIONS"
			on_action = "[OpenLateralView('expeditions')]"
		}
		action_tooltip = {
			click_type = right
			click_mode = single
			title = "GO_TO_LOCATION"
			on_action = "[PanToLocation(Expedition.GetCurrentLocation)]"
		}

		onmousehierarchyenter = "[PdxGuiWidget.SetHighlightLocation(Expedition.GetCurrentLocation)]"
	}

	blockoverride "category_color" {
		using = color_geopolitics_texture
	}
}
