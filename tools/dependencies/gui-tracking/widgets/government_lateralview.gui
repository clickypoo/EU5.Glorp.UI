																		fontsize = 14
																	}
																	expand = {}
																	text_single = {
																		autoresize = no
																		align = center
																		size = {65 25}
																		using = bg_number_container_bckg
																		blockoverride "number_container_color" {
																			alpha = 0.8
																			modify_texture = {
																				using = color_super_dark_brown_texture
																				blend_mode = multiply
																			}
																			modify_texture = {
																				using = color_purple_02_texture
																				blend_mode = multiply
																				alpha = 0.3
																			}
																		}
