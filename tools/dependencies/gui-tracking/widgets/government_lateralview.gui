											alpha = 1

										}

										pieslice = {
											texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
											value = "[GovernmentView.GetPlayer.GetGovernment.GetParliament.GetAddedParliamentIssueSupport]"
											color = { 0.3 0.8 0.3 1 }
											alpha = 0.8

