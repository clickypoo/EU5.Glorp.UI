template CountrySubject_tooltip {
	datacontext = "[Country.GetDiplomacy]"
	datacontext = "[Country.GetDiplomacy.GetSubjectType]"
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "SUBJECT_OF_HEADER_TT"
			
		}
		
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetSubjectTypeIcon(SubjectType.Self)]"
			}
		}
		
		blockoverride "concept_link" {
			text = [subject|E]
		}
		blockoverride "tooltip_content" {
			TooltipScrolledContentSection = {
				blockoverride "section_content"	{
					TooltipRowList = {
						visible = "[SubjectType.HasStatusRules]"
						blockoverride "block_title" {
							text = "SUBJECT_STATUS_TT"
						}
						textcontext = "[SubjectType.GetStatusRules(Country.GetDiplomacy.GetOverlord.Self, Country.Self)]"
					}
					
					TooltipRowList = {
						visible = "[SubjectType.HasAnnexationRules]"
						blockoverride "block_title" {
							text = "SUBJECT_ANNEXATION_TT"
						}
						textcontext = "[SubjectType.GetAnnexationRules(Country.GetDiplomacy.GetOverlord.Self, Country.Self)]"
					}
					TooltipRowList = {
						visible = "[Not(SubjectType.HasAnnexationRules)]"
						blockoverride "block_title" {
							text = "SUBJECT_ANNEXATION_TT"
						}
						textcontext = "SUBJECT_NOT_ANNEXATION_TT"
					}
					
					TooltipRowList = {
						visible = "[SubjectType.HasBuildingRules]"
						blockoverride "block_title" {
							text = "SUBJECT_BUILDING_TT"
						}
						textcontext = "[SubjectType.GetBuildingRules(Country.GetDiplomacy.GetOverlord.Self, Country.Self)]"
					}
					
					TooltipRowList = {
						visible = "[SubjectType.HasDiplomaticRules]"
						blockoverride "block_title" {
							text = "SUBJECT_DIPLOMATIC_TT"
						}
						textcontext = "[SubjectType.GetDiplomaticRules(Country.GetDiplomacy.GetOverlord.Self, Country.Self)]"
					}
				
					TooltipStringPairList = {
						visible = "[SubjectType.HasOverlordBenefits]"
						blockoverride "block_title" {
							text = "SUBJECT_BENEFITS_FOR_OVERLORD_TT"
						}
						textcontext = "[SubjectType.GetOverlordBenefits(Country.GetDiplomacy.GetOverlord.Self, Country.Self)]"
					}
					TooltipStringPairList = {
						visible = "[SubjectType.HasSubjectBenefits]"
						blockoverride "block_title" {
							text = "SUBJECT_BENEFITS_FOR_SUBJECT_TT"
						}
						textcontext = "[SubjectType.GetSubjectBenefits(Country.GetDiplomacy.GetOverlord.Self, Country.Self)]"
					}
					
					TooltipRowList = {
						visible = "[SubjectType.HasMonthly]"
						blockoverride "block_title" {
							text = "SUBJECT_MONTHLY_TT"
						}
						textcontext = "[SubjectType.GetMonthly(Country.GetDiplomacy.GetOverlord.Self, Country.Self)]"
					}

					TooltipFlavorTextBlock = {
						blockoverride "text" {
							text = "[SubjectType.GetFlavor]"
						}
					}
				}
			}
		}
	}
}
