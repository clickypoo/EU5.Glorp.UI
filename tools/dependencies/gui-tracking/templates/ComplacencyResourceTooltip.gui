template ComplacencyResourceTooltip {
	ContextualTooltipType = {
		blockoverride "title_icon_texture" {
			texture = "gfx/interface/icons/resources/complacency.dds"

			glow = {
				name = "drop_shadow"
				glow_radius = 3
				color = {0.0 0.0 0.0 1.0}
				alpha = 0.3
			}
		}

		blockoverride "title_text" {
			text = "COMPLACENCY_RESOURCE_TOOLTIP_T"
		}

		blockoverride "concept_link" {
			text = "[complacency|e]"
		}

		blockoverride "tooltip_content" {
			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "COMPLACENCY_TT_TEXT_CHANGE"
				}
				textcontext = "[Country.GetDescriptionFor('monthly_complacency')]"
			}

			TooltipRowList = {
				textcontext = "[GetComplacencyDisasters]"
			}

			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 350 } minimumsize = { -1 30 } }
				textcontext = "[Country.GetCurrencyTooltipDescription('complacency')]"
			}
		}


	}
}
