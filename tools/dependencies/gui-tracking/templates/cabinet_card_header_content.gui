# vanilla: in_game/gui/shared/cabinet_cards.gui
# mod: in_game/gui/shared/glorpUI_cabinet_cards.gui

template cabinet_card_header_content {
	hbox = {
		using = layoutpolicy_expanding
		spacing = 5
		margin_left = 10
		margin_right = 10

		widget = {
			visible = "[Cabinet.IsActive]"
			size = { 50 -1 }
			allow_outside = yes
			datacontext = "[Cabinet.GetAction]"
			cabinet_action_power = {
				visible = "[Cabinet.IsActive]"
				parentanchor = left|vcenter
				position = { -5 0 }
				blockoverride cabinet_action_power_bg_size {
					size = { 24 24 }
				}
				blockoverride cabinet_action_power_icon_size {
					size = { 95% 95%}
				}
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding

			text_single = {
				visible = "[Cabinet.IsActive]"
				layoutpolicy_horizontal = expanding
				size = { -1 25 }
				autoresize = no
				elide = right
				alwaystransparent = yes
				text = "[Cabinet.GetNameWithNoTooltip]"
				default_format = "#yellow_titles"
				align = left|nobaseline
			}

            tooltipwidget = {
                using = action_progress_tooltip
            }


			widget = {
				visible = "[Not(Cabinet.IsActive)]"
				layoutpolicy_horizontal = expanding
				size = { -1 32 }

				tooltipwidget = {
					BasicFunctionalTooltip = {
						blockoverride "tooltip_ui_action_block" {
							TooltipFunctionalBlock = {
								using = tooltip_left_click_template
								blockoverride "action_left_text" {
									text = "CABINET_ACTION_SIDEMENU"
								}
							}
						}
					}
				}

				background = {
					using = color_black_texture
					modify_texture = {
						using = bg_mask_fade_horizontal_middle_texture
						blend_mode = alphamultiply
					}
				}

				background = {
					using = color_red_texture
					alpha = 0.5
					modify_texture = {
						using = bg_mask_fade_horizontal_middle_texture
						blend_mode = alphamultiply
					}
				}

				text_single = {
					parentanchor = center
					alwaystransparent = yes
					text = "NO_CABINET_ACTION"
					using = Font_Size_Medium
					using = Font_Type_Flavor
					align = nobaseline
				}
			}
		}

		hbox = {
			datacontext = "[Cabinet]"
			tooltipwidget = {
				using = effective_skill_tooltip
			}
			widget = {
				visible = "[Cabinet.IsActive]"
				size = {70 25}
				text_single = {
					text = "[Cabinet.GetEffectiveSkill|2%+=]"
					align = right|nobaseline
					widgetanchor = right|vcenter
					parentanchor = right|vcenter
					margin = {5 2}
				}
			}

			cabinet_efficiency_icon = {}
		}

	}
}
