template RitePowerTooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "RITE_POWER_RESOURCE_TT_TEXT"
		}

		blockoverride "concept_link" {
			text = "[rite_power|e]"
		}
		
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/religious_doctrines/miaphysitism/rite_power.dds"
			}
		}
		
		blockoverride "tooltip_content" {
			datacontext = "[GetPlayer]"
			TooltipTextBlock = {
				blockoverride "text" {
					text = "RITE_POWER_TT_TEXT"
				}
			}
			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "RITE_POWER_TT_TEXT_CHANGE"
				}
				textcontext = "[Country.GetDescriptionFor('monthly_rite_power')]"
			}
			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 250 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "RITE_POWER_TT_TEXT_EFFECT"
				}
				textcontext = "[Country.GetCurrencyTooltipDescription('rite_power')]"
			}
		}
	}
}
