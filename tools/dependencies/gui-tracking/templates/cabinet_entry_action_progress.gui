# vanilla: in_game/gui/outliner_entries.gui
# mod: in_game/gui/outliner_entries.gui

template cabinet_entry_action_progress {
	widget = {
		layoutpolicy_vertical = expanding
		size = { 0 -1 }
		icon = {
			position = { -10 0 }
			visible = "[Cabinet.GetCharacter.IsHeadOfCabinet]"
			size = { 15 30 }
			using = button_outliner_texture
			blockoverride "texture_color" {
				modify_texture = {
					using = color_purple_texture
					blend_mode = add
				}
				modify_texture = {
					using = overlay_paper_03
					blend_mode = overlay
					alpha = 0.3
				}
				modify_texture = {
					using = overlay_cloth_texture
					blend_mode = overlay
					alpha = 0.1
				}
			}
			background = {
				using = button_outliner_texture
				blockoverride "texture_color" {
					modify_texture = {
						using = color_black_texture
						blend_mode = add
					}

				}
				margin_bottom = 1
				margin_left = 1
				alpha = 0.7
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_horizontal_textured.dds"
					texture_density = 4
					spriteType = stretched
					spriteBorder = { 0 0 }
					blend_mode = alphamultiply
					alpha = 1
				}
			}
			modify_texture = {
				texture = "gfx/interface/component_masks/mask_fade_horizontal_textured.dds"
				texture_density = 4
				spriteType = stretched
				spriteBorder = { 0 0 }
				blend_mode = alphamultiply
				alpha = 1
			}
		}
	}
	hbox = {
		spacing = -5
		portrait_standard_head_button = {
			datacontext = "[Cabinet.GetCharacter]"
			visible = "[Cabinet.IsCharacterSet]"
			size = { 30 30 }

			action_tooltip = {
				click_type = right
				click_mode = single

				title = "CHANGE_CABINET"
				cost = "[Cabinet.GetPriceForAssigningCabinetMemberToSlot]"
				enabled = "[Cabinet.ArePossibleCabinetCharactersAvailable]"
				description = "[Cabinet.GetDescriptionForAssigningCabinetMemberToSlot]"
				on_action_with_params = "[Cabinet.AssigningCabinetMemberToSlot]"
			}

			# blockoverride "character_tooltip" {
			# }
			blockoverride "character_contextmenu" {}
			blockoverride "button_setup" {
			}
			blockoverride "rightclick" {}
			# blockoverride "hover" {}
		}
		portrait_standard_head_button = {
			datacontext = "[Cabinet.GetCharacter]"
			visible = "[Not(Cabinet.IsCharacterSet)]"
			size = { 30 30 }

			action_tooltip = {
				click_type = left
				click_mode = single

				title = "SELECT_CABINET_CHARACTER"
				cost = "[Cabinet.GetPriceForAssigningCabinetMemberToSlot]"
				enabled = "[Cabinet.ArePossibleCabinetCharactersAvailable]"
				description = "[Cabinet.GetDescriptionForReplacingCabinetMemberToSlot]"
				on_action_with_params = "[Cabinet.AssigningCabinetMemberToSlot]"
			}

			blockoverride "character_tooltip" {
				tooltipwidget = {
					BasicFunctionalTooltip = {}
				}
			}
			blockoverride "character_contextmenu" {}
			blockoverride "button_setup" {
			}
			blockoverride "rightclick" {}
			# blockoverride "hover" {}
		}
		hbox = {
			margin_right = 5
			visible = "[Cabinet.IsCharacterSet]"
			datamodel = "[Cabinet.GetCharacter.GetTraitsByCategory('cabinet')]"
			item = {
				widget = {
					size = { 23 23 }
					using = trait_item
					blockoverride "trait_item_size" {
						size = { 23 23 }
					}
					blockoverride "trait_positive_negative_overlay" {
						allow_outside = yes
						icon = {
							ignore_layout = yes
							size = { 20 20 }
							position = { 10 10 }
							texture = "gfx/interface/buttons/flats/plus.dds"
							visible = "[Not(Trait.IsBad)]"
							modify_texture = {
								blend_mode = colordodge
								using = color_light_green_texture
							}
						}
						icon = {
							ignore_layout = yes
							size = { 14 16 }
							position = { 13 11 }
							texture = "gfx/interface/buttons/flats/minus.dds"
							visible = "[Trait.IsBad]"
							modify_texture = {
								blend_mode = colordodge
								using = color_red_texture
							}
						}
					}
				}
			}
		}
		cabinet_efficiency_icon = {
			blockoverride "icon_size" { size = { 23 23 } }
			tooltipwidget = {
				using = effective_skill_tooltip
			}
		}
	}
	block "cabinet_entry_title_text" {
		OutlinerTextBase = {
			using = layoutpolicy_expanding
			text = "[Cabinet.GetNameWithNoTooltip]"
			align = left
			default_format = "#L"
			maximumsize = { 160 -1 }
		}
	}
	expand = {}

	block "cabinet_entry_progress_text" {
		OutlinerTextBase = {
			maximumsize = { 90 -1 }
			autoresize = yes
			text = "[Cabinet.GetActionProgress]"
		}
	}
}
