# vanilla: in_game/gui/shared/topbar_tooltips.gui
# mod: in_game/gui/shared/topbar_tooltips.gui

template SailorsResourceTooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "SAILORS_TOOLTIP_T"
		}

		blockoverride "concept_link" {
			text = "[sailors|E]"
		}
		
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/resources/sailors.dds"
			}
		}

		blockoverride "title_button" {
			hint_button = {
                action_tooltip = {
                    title = "OPEN_HINT"
                    on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_low_sailors')]"
                }
            }
        }
		
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "SAILORS_TOOLTIP"
				}
			}
			
			TooltipTextBlock = {
				blockoverride "text" {
					text = "[Country.GetMaxSailorsTT]"
				}
			}

			TooltipScrolledStringPairList = {
				block "content_datacontext" {}
				block "change_visibility" {}
				blockoverride "block_scrollarea" { maximumsize = { -1 150 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "SAILORS_TT_TEXT"
				}
				textcontext = "[Country.GetCurrencyTooltipValueDescription('sailors')]"
			}
		}
	}
}
