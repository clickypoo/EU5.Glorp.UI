# vanilla: in_game/gui/shared/diplomacy_tooltips.gui
# mod: in_game/gui/shared/diplomacy_tooltips.gui

template TruceTooltip {
	ContextualTooltipType = {
		blockoverride "title_icon_texture" {
			texture = "gfx/interface/icons/diplomatic_status/truce.dds"
		}
	
		blockoverride "title_text" {				
			text = "TRUCE_WITH_COUNTRY_TITLE"
		}
				
		blockoverride "concept_link" {
			text = "[truce|E]"
		}

		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "[RelationDescItem.GetToolTip]"												
				}
			}
		}
	}
}
