template AntagonismTooltipBase {
	ContextualTooltipType = {
		blockoverride "concept_link" {
			text = "[antagonism|E]"
		}
		
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/resources/antagonism.dds"
			}
		}
		
		blockoverride "tooltip_content" {
			TooltipScrolledStringPairList = {
				visible = "[Country.HasModifierValue('antagonism_received_modifier')]"
				block "content_datacontext" {}
				blockoverride "block_scrollarea" { maximumsize = { -1 150 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "ANTAGONISM_IMPACT_T"
				}
				textcontext = "[Country.GetModifierValue('antagonism_received_modifier')]"
			}
			TooltipScrolledStringPairList = {
				block "content_datacontext" {}
				blockoverride "block_scrollarea" { maximumsize = { -1 150 } minimumsize = { -1 30 } }
				block "antagonism_datacontext" {
					textcontext = "[Country.GetDiplomacy.GetAntagonismDescription(ForeignCountryView.GetPlayer)]"
				}
			}
		}
	}
}
