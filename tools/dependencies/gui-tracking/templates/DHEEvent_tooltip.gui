# vanilla: in_game/gui/shared/event_tooltips.gui
# mod: in_game/gui/shared/glorpUI_event_tooltips.gui

template DHEEvent_tooltip { # GlorpUI: rebuilt on the DHETooltip types

	DHETooltip = {
		using = bg_age_event_frame
		using = bg_age_event_inner
		using = bg_age_event_frame
		using = bg_secondary_inner_alt

		blockoverride "title_text" {
			text = "[DHEEventEntry.GetTitle]"
		}
		blockoverride "subtitle_text" {
			text = "[Localize('FROM_MARKET')] [DHEEventEntry.GetDateRange] | [Localize('DHE_MONTHLY_CHANCE')]"
		}

		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetAgeIcon(DHEEventEntry.GetAge)]"
				datacontext = "[DHEEventEntry.GetAge]"
				tooltipwidget = {
					using = Age_tooltip
				}
			}
		}

		blockoverride "concept_link" {
			text = "[dynamic_historical_event|e]"
		}

		blockoverride "tooltip_content" {

			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[DHEEventEntry.GetDebugInfo]"
				}
			}

			# DHEFlavorTextBlock = {
			# 	visible = "[Not(StringIsEmpty(DHEEventEntry.GetDescription))]"
			# 	blockoverride "text" {
			# 		text = "[DHEEventEntry.GetDescription]"
			# 	}
			# }

			DHETooltipEntry = {
				blockoverride "content" {
					TooltipListBase = {
						TooltipManualTableField = {
							background = {
								visible = "[DHEEventEntry.IsStatusHasHappened]"
								using = color_mid_green_texture
								# alpha = 0.2
							}
							icon = {
								size = { 25 25 }
								texture = "gfx/interface/icons/text_icons/dhe_status_has_happened.dds"
								visible = "[DHEEventEntry.IsStatusHasHappened]"
							}

							background = {
								visible = "[DHEEventEntry.IsStatusNotYet]"
								texture = "gfx/interface/colors/black.dds"
								margin = { 1 1 }
								margin_bottom = 2
								texture_density = 2
								alpha = 0.4
							}
							background = {
								using = color_geopolitics_texture
								alpha = 0.6
								visible = "[DHEEventEntry.IsStatusNotYet]"
							}
							icon = {
								size = { 25 25 }
								texture = "gfx/interface/icons/text_icons/dhe_status_has_not_happened_yet.dds"
								visible = "[DHEEventEntry.IsStatusNotYet]"
							}

							background = {
								visible = "[DHEEventEntry.IsStatusTimeHasPassed]"
								using = color_greyish_texture
								# alpha = 0.2
							}
							icon = {
								size = { 25 25 }
								texture = "gfx/interface/icons/text_icons/dhe_status_time_has_passed.dds"
								visible = "[DHEEventEntry.IsStatusTimeHasPassed]"
							}

							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no
								text = "[DHEEventEntry.GetStatusLabel]"
							}
						}
					}
					TooltipManualTableField = {
						text_single = {
							layoutpolicy_horizontal = expanding
							autoresize = no
							raw_text = "[DHEEventEntry.GetDateRange]"
						}
						text_single = {
							autoresize = yes
							text = "DHE_MONTHLY_CHANCE"
						}
					}
				}
				blockoverride "subtitle_text" { text = "LIST_TITLE_CHRONOLOGY" }
				blockoverride "subtitle_icon" { texture = "gfx/interface/icons/work_of_art/chronicle.dds" }

			}

			DHEOptionsList = {
				textcontext = "[DHEEventEntry.GetEffects]"

				tooltipmeta = {
					texture = "[GetConceptTexture('event_option')]"
					game_concept = "[event_option|e]"
				}

				# blockoverride "block_title" {
				# 	text = "EVENT_POSSIBLE_OPTIONS"
				# }
			}

			DHETooltipEntry = {
				blockoverride "content" {
					TooltipScrolledRequirementsList = {
						textcontext = "[DHEEventEntry.GetTrigger]"

						blockoverride "block_title" {
							text = "[SelectLocalization(DHEEventEntry.IsTriggerTrue, 'REQUIREMENT_ARE_MET', 'REQUIREMENT_ARE_NOT_MET')]"

							background = {
								visible = "[DHEEventEntry.IsTriggerTrue]"
								using = color_mid_light_green_texture
								alpha = 0.9
							}

							background = {
								visible = "[Not(DHEEventEntry.IsTriggerTrue)]"
								using = color_mid_red_texture
								alpha = 0.7
							}
						}

						blockoverride "block_scrollarea" { maximumsize = { -1 350 }}
					}
				}
				blockoverride "subtitle_text" { text = "LIST_TITLE_REQUIREMENTS" }
				blockoverride "subtitle_icon" { texture = "gfx/interface/icons/flat_icons/trigger.dds" }

			}

			DHEFlavorTextBlock = {
				visible = "[DHEEventEntry.HasHistoricalInfo]"
				blockoverride "text" {
					text = "[DHEEventEntry.GetHistoricalInfo]"
				}
			}
		}
	}
}
