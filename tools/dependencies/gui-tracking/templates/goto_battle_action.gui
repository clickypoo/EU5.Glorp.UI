# vanilla: in_game/gui/battle_lateralview.gui
# mod: in_game/gui/battle_lateralview.gui

template goto_battle_action {
	block "battle_goto_action" {
		action_tooltip = {
			click_type = left
			click_mode = single
			title = "SHOW_BATTLE"
			on_action = "[ShowCombat(Combat.Self)]"
		}
	}
	tooltipwidget = { BasicFunctionalTooltip = {} }
}
