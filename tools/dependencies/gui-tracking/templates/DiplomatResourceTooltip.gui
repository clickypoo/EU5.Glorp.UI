# vanilla: in_game/gui/shared/topbar_tooltips.gui
# mod: in_game/gui/shared/topbar_tooltips.gui

template DiplomatResourceTooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "DIPLOMATS_RESOURCE_TOOLTIP_T"
		}

		blockoverride "concept_link" {
			text = "[diplomats|e]"
		}
		

		blockoverride "title_button" {
			hint_button = {
                action_tooltip = {
                    title = "OPEN_HINT"
                    on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_low_diplomats')]"
                }
            }
        }
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/resources/diplo_actions.dds"
			}
		}
		
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "DIPLOMATS_RESOURCE_TT_TEXT"
				}
			}
			TooltipStringPairList = {
				blockoverride "block_title" {
					text = "MAX_DIP_SOURCES"
				}
				textcontext = "[Country.GetDescriptionFor('max_diplomats')]"
			}
			TooltipStringPairList = {
				block "change_visibility" {}
				blockoverride "block_title" {
					text = "MONTHLY_DIP_SOURCES"
				}
				textcontext = "[Country.GetDescriptionFor('monthly_diplomats')]"
			}
			TooltipStringPairList = {
				textcontext = "DIPLOMATS_CAPACITY_TT_TEXT"
				tooltipwidget = {
					using = DiplomaticCapacity_tooltip
				}
			}
		}
	}
}
