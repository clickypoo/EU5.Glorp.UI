# vanilla: in_game/gui/shared/diplomacy_tooltips.gui
# mod: in_game/gui/shared/diplomacy_tooltips.gui

template ThreatenWarAcceptanceTooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			country_flag_mid = {
				datacontext = "[ThreatenTarget.GetLocation.GetOwner]"
			}
		}

		blockoverride "title_text" {
			text = "[ThreatenTarget.GetLocation.GetNameWithNoTooltip]"
		}

		blockoverride "concept_link" {
			text = "[diplomatic_action|e]"
		}

		blockoverride "tooltip_content" {

			TooltipScrolledConditionList = {
				ontextcontextchanged = "[SetConditionListWithTitleFromTextContext(PdxGuiWidget.AccessSelf)]"
				
				blockoverride "block_scrollarea" { maximumsize = { -1 200 }}
				blockoverride "block_title" {
					text = "IF_THEY_ACCEPT"
				}
				textcontext = "[ThreatenWarView.GetEffect]"
			}

			TooltipConditionList = {
				visible = "[Not(ThreatenTarget.IsEnabled)]"
				blockoverride "block_title" {
					text = "NOT_POSSIBLE_DUE_TO"
				}
				datacontext = "[StringToConditionListWithTitleOnlyFailAndNeutral(ThreatenTarget.GetDescription)]"
			}

			TooltipScrolledStringPairList = {
				ontextcontextchanged = "[SetStringPairListWithTitleFromTextContext(PdxGuiWidget.AccessSelf)]"
				# visible = "[Not(EqualTo_int32(ThreatenTarget.GetAcceptanceFrame, '(int32)1'))]"
				blockoverride "block_scrollarea" { maximumsize = { -1 200 }}
				textcontext = "[ThreatenTarget.GetAcceptanceTooltip]"
			}

			TooltipTextBlock = {
				blockoverride "text" {
					text = "GOOD_BAD_RATIO_T"
				}
			}

			TooltipTableHeader = {
				blockoverride "tableheader_text" {
					raw_text = "[SelectLocalization( EqualTo_int32(ThreatenTarget.GetAcceptanceFrame, '(int32)1'), '@trigger_no!', '@trigger_yes!' )]  [SelectLocalization( EqualTo_int32(ThreatenTarget.GetAcceptanceFrame, '(int32)1'), 'DIPLOMACY_WILL_NOT_ACCEPT', 'DIPLOMACY_WILL_ACCEPT' )]"
				}
			}
		}
	}
}
