# vanilla: in_game/gui/shared/topbar_tooltips.gui
# mod: in_game/gui/shared/topbar_tooltips.gui

template PrestigeResourceTooltip {
	ContextualTooltipType = {
		blockoverride "title_icon_texture" {
			texture = "gfx/interface/icons/resources/prestige.dds"

			glow = {
				name = "drop_shadow"
				glow_radius = 3
				color = {0.0 0.0 0.0 1.0}
				alpha = 0.3
			}
		}

		blockoverride "title_text" {
			text = "PRESTIGE_RESOURCE_TOOLTIP_T"
		}

		blockoverride "concept_link" {
			text = "[prestige|e]"
		}

		blockoverride "tooltip_content" {
			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 250 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "PRESTIGE_RESOURCE_TT_TEXT"
				}
				textcontext = "[Country.GetCurrencyTooltipDescription('prestige')]"
			}
			TooltipScrolledStringPairList = {
				block "content_datacontext" {}
				block "change_visibility" {}
				blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
				textcontext = "[CEconomy.GetExpenseSettingInvestmentTooltip('cultural_maintenance')]"
			}
		}
	}
}
