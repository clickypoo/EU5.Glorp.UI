template GenericAction_tooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "[GenericAction.GetNameWithNoTooltip]"
		}

		blockoverride "title_icon_texture" {
			texture = "[GenericAction.GetIcon]"
		}

		blockoverride "concept_link" {
			text = [action|E]
		}

		blockoverride "tooltip_content" {
			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[GenericAction.GetDebugText]"
				}
			}
			TooltipTextBlock = {
				blockoverride "text" {
					text = "[GenericAction.GetBasicTooltip]"
				}
			}
		}
	}
}
