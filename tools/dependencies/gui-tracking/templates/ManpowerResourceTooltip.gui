template ManpowerResourceTooltip {
	ContextualTooltipType = {
		blockoverride "title_text" {
			text = "MANPOWER_TOOLTIP_T"
		}

		blockoverride "concept_link" {
			text = "[manpower|E]"
		}
		
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "gfx/interface/icons/resources/manpower.dds"
			}
		}

		blockoverride "title_button" {
			hint_button = {
                action_tooltip = {
                    title = "OPEN_HINT"
                    on_action = "[OpenLateralViewWithParams('hints', 'selected_hint = hint_manpower')]"
                }
            }
        }
		
		blockoverride "tooltip_content" {
			TooltipTextBlock = {
				blockoverride "text" {
					text = "MANPOWER_TOOLTIP"
				}
			}
			TooltipTextBlock = {
				blockoverride "text" {
					text = "[Country.GetMaxManpowerTT]"
				}
			}
			
			
			
			TooltipScrolledStringPairList = {
				block "content_datacontext" {}
				block "change_visibility" {}
				blockoverride "block_scrollarea" { maximumsize = { -1 150 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "MANPOWER_TT_TEXT"
				}
				textcontext = "[Country.GetCurrencyTooltipValueDescription('manpower')]"
			}
		}
	}
}
