template CountryTooltip_RelativePower {
	visible = "[And3(Not(IsLobbyOpen), IsPlayerValid, Not(Country.IsPlayer))]"

	TooltipListBase = {
		#Relative Power STRONGER
		background = {
			visible = "[GreaterThan_CFixedPoint(GetOverallPowerRatio(Player.Self, Country.Self), '(CFixedPoint)0.60')]"
			using = text_mask_container_texture
			margin_bottom = 0
			alpha = 0.5

			modify_texture = {
				using = color_light_green_texture
			}
		}
		#Relative Power EQUAL
		background = {
			visible = "[And(LessThan_CFixedPoint(GetOverallPowerRatio(Player.Self, Country.Self), '(CFixedPoint)0.61'), GreaterThan_CFixedPoint(GetOverallPowerRatio(Player.Self, Country.Self), '(CFixedPoint)0.39'))]"
			using = text_mask_container_texture
			margin_bottom = 0
			alpha = 0.5

			modify_texture = {
				using = color_yellow_texture
			}
		}
		#Relative Power WEAKER
		background = {
			visible = "[LessThan_CFixedPoint(GetOverallPowerRatio(Player.Self, Country.Self), '(CFixedPoint)0.40')]"
			using = text_mask_container_texture
			margin_bottom = 1
			alpha = 0.5

			modify_texture = {
				using = color_red_texture
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			margin = { 10 3 }
			spacing = 5
			tooltipwidget = { using = RelativePower_tooltip_country }

			widget = {
				size = { 25 25 }
				tagtooltip_enabled = yes

				icon = {
					size = { 100% 100% }
					texture = "gfx/interface/icons/foreign_country/country_power.dds"
					texture_density = 2
					alpha = 1
					glow = {
						name = "drop_shadow"
						glow_radius = 3
						color = {0.0 0.0 0.0 1.0}
						alpha = 0.5
					}
				}
			}

			text_multi = {
				layoutpolicy_horizontal = expanding
				size = {-1 25}
				autoresize = no
				align = left|vcenter
				default_format = "#yellow_titles"
				text = "[GetRelativePowerDescriptionTooltip(GetSelectedCountryOrByLocation.Self, Country.Self)]"
				fontsize = 14
				using = FontDefaultColor
			}
		}
	}
}
