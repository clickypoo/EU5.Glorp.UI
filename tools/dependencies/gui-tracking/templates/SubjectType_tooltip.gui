# vanilla: in_game/gui/shared/diplomacy_tooltips.gui
# mod: in_game/gui/shared/diplomacy_tooltips.gui

template SubjectType_tooltip {
	ContextualTooltipType = {
		block "data_context" {}
		blockoverride "title_text" {
			text = "[SubjectType.GetNameWithNoTooltip]"
		}

		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetSubjectTypeIcon(SubjectType.Self)]"
			}
		}


		blockoverride "concept_link" {
			text = [subject_type|E]
		}
		blockoverride "tooltip_content" {
			TooltipDebugTextBlock = {
				blockoverride "text" {
					debug_text = "[SubjectType.GetDebugText]"
				}
			}
			TooltipFlavorTextBlock = {
				blockoverride "text" {
					text = "[SubjectType.GetFlavor]"
				}
			}
			TooltipScrolledContentSection = {
				blockoverride "block_scrollarea" { maximumsize = { -1 600 }}
				blockoverride "section_content"	{
					TooltipRowList = {
						visible = "[SubjectType.HasStatusRules]"
						blockoverride "block_title" {
							text = "SUBJECT_STATUS_TT"
						}
						textcontext = "[SubjectType.GetStatusRulesForType]"
					}

					TooltipRowList = {
						visible = "[SubjectType.HasAnnexationRules]"
						blockoverride "block_title" {
							text = "SUBJECT_ANNEXATION_TT"
						}
						textcontext = "[SubjectType.GetAnnexationRulesForType]"
					}

					TooltipRowList = {
						visible = "[Not(SubjectType.HasAnnexationRules)]"
						blockoverride "block_title" {
							text = "SUBJECT_ANNEXATION_TT"
						}
						textcontext = "SUBJECT_NOT_ANNEXATION_TT"
					}

					TooltipRowList = {
						visible = "[SubjectType.HasBuildingRules]"
						blockoverride "block_title" {
							text = "SUBJECT_BUILDING_TT"
						}
						textcontext = "[SubjectType.GetBuildingRulesForType]"
					}

					TooltipRowList = {
						visible = "[SubjectType.HasDiplomaticRules]"
						blockoverride "block_title" {
							text = "SUBJECT_DIPLOMATIC_TT"
						}
						textcontext = "[SubjectType.GetDiplomaticRulesForType]"
					}

					TooltipStringPairList = {
						visible = "[SubjectType.HasOverlordBenefits]"
						blockoverride "block_title" {
							text = "SUBJECT_BENEFITS_FOR_OVERLORD_TT"
						}
						textcontext = "[SubjectType.GetOverlordBenefitsForType]"
					}
					TooltipStringPairList = {
						visible = "[SubjectType.HasSubjectBenefits]"
						blockoverride "block_title" {
							text = "SUBJECT_BENEFITS_FOR_SUBJECT_TT"
						}
						textcontext = "[SubjectType.GetSubjectBenefitsForType]"
					}

					TooltipRowList = {
						visible = "[SubjectType.HasMonthly]"
						blockoverride "block_title" {
							text = "SUBJECT_MONTHLY_TT"
						}
						textcontext = "[SubjectType.GetMonthlyForType]"
					}
				}
			}
		}
	}
}
