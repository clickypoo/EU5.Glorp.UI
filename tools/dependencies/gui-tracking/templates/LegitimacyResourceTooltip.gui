template LegitimacyResourceTooltip {
	ContextualTooltipType = {
		blockoverride "title_icon" {
			icon = {
				using = tooltip_title_icon_size
				texture = "[GetLegitimacyIcon(Country.GetGovernment.GetGovernmentType)]"

				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.3
				}
			}
		}

		blockoverride "title_text" {
			text = "GOVERNMENT_POWER_RESOURCE_TOOLTIP_T"
		}

		blockoverride "concept_link" {
			text = "[Localize(Country.GetGovernment.GetGovernmentType.GetPowerConcept)]"
		}

		blockoverride "tooltip_content" {
			TooltipScrolledStringPairList = {
				blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
				blockoverride "block_title" {
					text = "GOVERNMENT_POWER_RESOURCE_TT_TEXT"
				}
				textcontext = "[Localize(ShowAutoModifierEffectForCountry(Country.Self, 'legitimacy'))]"
			}
			TooltipScrolledStringPairList = {
				block "content_datacontext" {}
				block "change_visibility" {}
				blockoverride "block_scrollarea" { maximumsize = { -1 300 } minimumsize = { -1 30 } }
				textcontext = "[CEconomy.GetExpenseSettingInvestmentTooltip('court_maintenance')]"
			}
		}
	}
}
