# vanilla: in_game/gui/panels/left_panel/left_panel.gui
# mod: in_game/gui/panels/left_panel/left_panel.gui

template player_stat_bg {
	background = {
		texture = "[GetGraphicalCultureTexture('top_bar_sideflavor')]"
		texture_density = 2
		spriteType = Corneredstretched
		spriteborder = { 17 17 }
		alpha = 0.3

		modify_texture = {
			using = color_bg_brown_texture
			blend_mode = multiply
			alpha = 0.9
		}
	}

	background = {
		block "decreasing_value_gradient_visible" {
			visible = no
		}

		texture = "gfx/interface/component_masks/mask_fade_horizontal_right.dds"
		texture_density = 2
		spriteType = stretched
		alpha = 0.5

		margin_top = -3
		margin_bottom = -3
		margin_right = -40

		modify_texture = {
			using = color_red_texture
			blend_mode = multiply
		}
	}

	background = {
		block "context_value_gradient_visible" {
			visible = no
		}

		using = bg_fade_vertical_up_noborder_mask_texture
		alpha = 0.6

		margin_top = 30
		margin_bottom = -3

		modify_texture = {
			using = color_gold_texture
			blend_mode = normal
		}

		modify_texture = {
			using = bg_fade_vertical_up_mask_texture
			blend_mode = alphamultiply
		}

		modify_texture = {
			using = bg_fade_vertical_up_mask_texture
			blend_mode = alphamultiply
		}
	}
}
