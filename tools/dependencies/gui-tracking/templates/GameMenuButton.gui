template GameMenuButton {
	texture = "gfx/interface/buttons/button_regular.dds"
	texture_density = 2
	alpha = 1
	spriteType = corneredstretched
	spriteborder = { 14 14 }
	frame_grid = { 4 1 }

	modify_texture = {
		using = overlay_stone_texture
		blend_mode = overlay
		alpha = 0.3
	}

	using = Font_Type_Standard
	parentanchor = top|hcenter
	# clicksound = "click_ok"
}
