# vanilla: in_game/gui/panels/organization/common.gui
# mod: in_game/gui/panels/organization/common.gui

	type io_subheader_select_menu_left = select_menu_left {
		blockoverride "menu_setup" {
			name = "io_subheader_select_menu"
		}
		blockoverride "close_button" {
			onclick = "[IoSubheaderSelectMenu.OnClose]"
		}

		blockoverride "select_content" {
			minimumsize = { 350 -1 }
			spacing = 0
			datacontext = "[IoSubheaderSelectMenu.Parent]"
			widget = {
				layoutpolicy_horizontal = expanding
				size = { -1 35 }
				# using = bg_card_header_01
				background = {
					texture = "gfx/interface/buttons/button_banner_02.dds"
					texture_density = 2
					alpha = 1
					spriteType = corneredstretched
					spriteborder = { 40 0 }
					frame_grid = {4 1}
					frame = 1
					margin = { 13 3 }

					modify_texture = {
						using = overlay_cloth_texture
						blend_mode = overlay
						alpha = 0.1
					}
				}

				button_checkbox_visibility = {
					size = { 30 30 }
					position = { 5 1 }
					checked = "[InternationalOrganizationsView.Vars.Exists( 'laws_extended_view')]"
					onclick = "[InternationalOrganizationsView.Vars.Toggle( 'laws_extended_view')]"
					tooltipwidget = {
						LeftClickButtonTooltip = {
							blockoverride "onclick_text" {
								text = "[SelectLocalization(InternationalOrganizationsView.Vars.Exists( 'laws_extended_view'), 'LAWS_COMPACTED_VIEW', 'LAWS_EXPANDED_VIEW')]"
							}
						}
					}
				}

				text_single = {
					margin_top = 2
					parentanchor = hcenter
					fontsize = 16
					text = "IMPERIAL_CONSTITUTION"
					default_format = "#T"
				}
			}
			filtered_sorted_list_no_scroll = {
				minimumsize = { 350 -1 }
				datacontext = "[IoSubheaderSelectMenu.Parent.GetLawsSortSearch]"

				blockoverride "filtered_no_scroll_content" {
					visible = "[Not(InternationalOrganizationsView.Vars.Exists( 'laws_extended_view'))]"
					spacing = 5
					datamodel = "[InternationalOrganizationsView.GetAllLaws]"
					item = {
						vbox = {
							layoutpolicy_horizontal = expanding
	
							card_list_action_button = {
								layoutpolicy_horizontal = expanding
								size = { -1 44 }
								visible = "[Not(StringIsEmpty(ResolutionGlue.GetEnactResolution.GetKey))]"
								blockoverride "texture" {
									gfxtype = framedbuttongfx
									effectname = "NoHighlight"
									upframe = 1
									overframe = 2
									downframe = 3
									disableframe = 4
									texture = "gfx/interface/buttons/list_card_button.dds"
									frame_grid = {4 1}
									spriteType = Corneredstretched
									spriteborder = { 0 0 }
									texture_density = 2
								}
								icon = {
									ignore_layout = yes
									size = {99% 97%}
									parentanchor = center
									block "law_unique_flavor_visible" {
										visible = "[ResolutionGlue.GetTarget('target').GetLaw.IsUnique]"
									}
									texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
									texture_density = 2
									mirror = horizontal
									alpha = 0.1
									modify_texture = {
										texture = "[ResolutionGlue.GetBgCategoryColor]"
										texture_density = 2
										blend_mode = multiply
									}
								}
								block "law_action_button_setup" {
									enabled = "[UIAction.IsEnabled]"
									proposer = "[ResolutionGlue.GetProposer]"
									actor = "[IoSubheaderSelectMenu.Parent.GetPlayer]"
									left_action = {
										action_name = "[ResolutionGlue.GetEnactResolution.GetKey]"
										parameter = {
											parameter_name = "recipient"
											parameter_value = "[IoSubheaderSelectMenu.Parent.GetInternationalOrganization]"
										}
										parameter = {
											parameter_name = "target"
											parameter_value = "[ResolutionGlue.GetTarget('target').GetLaw]"
										}
									}
									datacontext = "[ResolutionGlue.GetTarget('target').GetLaw]"
									tooltipwidget = { using = IO_Law_tooltip }
								}
								hbox = {
									margin = { 4 0 }
									spacing = 10
									layoutpolicy_horizontal = expanding
									widget = {
										size = { 36 36 }
										background = {
											texture = "gfx/interface/component_tiles/laws_background_frame.dds"
											texture_density = 2
											spriteType = corneredstretched
											spriteBorder = { 0 0 }
											modify_texture = {
												texture = "[ResolutionGlue.GetBgCategoryColor]"
												blend_mode = multiply
											}
											modify_texture = {
												using = overlay_cloth_texture
												blend_mode = overlay
												alpha = 0.2
											}
											modify_texture = {
												using = color_black_texture
												blend_mode = overlay
												alpha = 0.3
											}
										}
										icon = {
											size = { 90% 90% }
											parentanchor = center
											texture = "[GetLawIcon(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
										}
									}
	
									vbox = {
										layoutpolicy_horizontal = expanding
										ignoreinvisible = yes
										text_single = {
											layoutpolicy_horizontal = expanding
											using = Font_Size_Small
											align = nobaseline|left
											default_format = "#yellow_titles"
											block "law_title" {
												text = "[ResolutionGlue.GetTarget('target').GetLaw.GetNameWithNoTooltip]"
											}
										}
										hbox = {
											layoutpolicy_horizontal = expanding

											text_single = {
												autoresize = yes
												maximumsize = { 140 -1 }
												align = nobaseline|left
												fontsize = 13
												visible = "[IoSubheaderSelectMenu.Parent.GetInternationalOrganization.HasPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
												text = "[IoSubheaderSelectMenu.Parent.GetInternationalOrganization.GetPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self).GetNameWithNoTooltip]"
											}
											text_single = {
												align = nobaseline|left
												fontsize = 13
												visible = "[Not(IoSubheaderSelectMenu.Parent.GetInternationalOrganization.HasPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self))]"
												text = "NO_POLICY_SELECTED"
											}
											expand = {}

											text_single = {
												autoresize = yes
												maximumsize = { 140 -1 }
												align = nobaseline|left
												visible = "[IoSubheaderSelectMenu.Parent.GetInternationalOrganization.HasPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
												text = "[IoSubheaderSelectMenu.Parent.GetInternationalOrganization.GetPolicyImplementedDateStringForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
											}
										}
									}
								}
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								using = bg_paper_card
								margin = { 0 4 }
								margin_right = 4
								expand = {}
								hbox = {
									spacing = 8
									datacontext = "[ResolutionGlue.GetTarget('target').GetLaw]"
									datamodel = "[Law.GetPoliciesDataModel]"
									item = {
										widget = {
											size = { 28 28 }
											background = {
												visible = "[And(IoSubheaderSelectMenu.Parent.GetInternationalOrganization.HasPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self), ObjectsEqual(IoSubheaderSelectMenu.Parent.GetInternationalOrganization.GetPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self), Policy.Self))]"
												texture = "gfx/interface/advance/advances_glow/advances_glow_yellow.dds"
												texture_density = 2
												alpha = 0.7
												margin = { 10 10 }
											}
											header_action_button_left = {
												size = { 100% 100% }
												blockoverride "icon_overlay"{}
												blockoverride "button_icon_stretch_sprite" {}
												blockoverride "header_button_frame_inner" { visible = no }
												blockoverride "header_button_icon_size" { size = { 24 24 } }
												blockoverride "header_button_text_layout" {}
												blockoverride "icon_texture" {
													texture = "[GetLawIcon(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
													texture_density = 2
												}
												title = "[Policy.GetNameWithNoTooltip]"
												actor = "[IoSubheaderSelectMenu.Parent.GetPlayer]"
												enabled = "[UIAction.IsEnabled]"
												proposer = "[ResolutionGlue.GetProposer]"
												parameter = {
													parameter_name = "recipient"
													parameter_value = "[IoSubheaderSelectMenu.Parent.GetInternationalOrganization]"
												}
												parameter = {
													parameter_name = "target"
													parameter_value = "[ResolutionGlue.GetTarget('target').GetLaw]"
												}
												parameter = {
													parameter_name = "vote"
													parameter_value = "[ResolutionGlue.GetTarget('target').GetLaw.GetPolicyAtIndex(PdxGuiWidget.GetIndexInDataModel)]"
												}
												left_click_and_hold_action = {
													action_name = "[ResolutionGlue.GetEnactResolution.GetKey]"
												}
												tooltipwidget = {
													using = action_tooltip_pop_out
													blockoverride "title_icon_texture" {
														texture = "[GetLawIcon(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
													}
													blockoverride "concept_link" {
														text = "[policy|e]"
													}
												}
											}
										}
									}
								}
								expand = {}
								hbox = {
									widget = {
										size = { 31 31 }
										using = bg_circle
										visible = "[ResolutionGlue.GetOwner.ShouldDisplayProgressForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
										piechart = {
											size = { 100% 100% }
											parentanchor = center
											using = piechart_angles
											icon = {
												parentanchor = center
												size = { 70% 70% }
												texture = "gfx/interface/icons/situations/_default.dds"
												texture_density = 2
											}
											pieslice = {
												texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
												value = "[FixedPointToFloat(ResolutionGlue.GetOwner.GetPolicyProgressForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self))]"
												using = color_value_progress_blue
											}
											pieslice = {
												texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
												value = "[Subtract_float('(float)100.0', FixedPointToFloat(ResolutionGlue.GetOwner.GetPolicyProgressForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self)))]"
												using = color_value_progress_gray
											}
											using = bg_circle_piechart
										}
									}
									widget = {
										size = { 31 31 }
										using = bg_circle
										visible = "[Or(ResolutionGlue.EnactResolutionIsActive, ResolutionGlue.RepealResolutionIsActive)]"
										piechart = {
											size = { 100% 100% }
											using = piechart_angles
											parentanchor = center
											icon = {
												visible = "[Not(ResolutionGlue.HasCountryVotedFromPointer(Player.Self))]"
												parentanchor = center
												size = { 70% 70% }
												texture = "gfx/interface/icons/international_organizations/law_voting.dds"
												texture_density = 2
											}
											icon = {
												visible = "[ResolutionGlue.HasCountryVotedFromPointer(Player.Self)]"
												parentanchor = center
												size = { 70% 70% }
												texture = "gfx/interface/icons/international_organizations/law_voting_yes.dds"
												texture_density = 2
											}
											pieslice = {
												texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
												value = "[FixedPointToFloat(ResolutionGlue.GetProgressToDeadline)]"
												using = color_value_progress_blue
											}
											pieslice = {
												texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
												value = "[Subtract_float('(float)100.0', FixedPointToFloat(ResolutionGlue.GetProgressToDeadline))]"
												using = color_value_progress_gray
											}
											datacontext = "[ResolutionGlue.GetVoteToEnactAction]"
											tooltipwidget = {
												using = international_organization_resolution_voting_tooltip
											}
										}
									}
								}
							}
						}
					}
				}

				blockoverride "filtered_no_scroll_content_extra" {
					visible = "[InternationalOrganizationsView.Vars.Exists( 'laws_extended_view')]"
					spacing = 15
					datamodel = "[InternationalOrganizationsView.GetAllLaws]"
					item = {
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 5
							datacontext = "[ResolutionGlue.GetTarget('target').GetLaw]"
							using = bg_paper_card
							margin_bottom = 2
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 10
								margin_left = 5

								background = {
									texture = "gfx/interface/buttons/bg_navigational_header_button.dds"
									texture_density = 2
									spriteType = corneredstretched
									spriteborder = { 42 20 }

									modify_texture = {
										texture = "[ResolutionGlue.GetBgCategoryColor]"
										blend_mode = multiply
									}
									modify_texture = {
										using = overlay_stone_texture
										blend_mode = overlay
										alpha = 0.5
									}
									modify_texture = {
										using = overlay_window_texture
										blend_mode = overlay
										alpha = 0.5
									}
								}
								
								using = bg_cabinet_card_frame

								icon = {
									size = { 38 38 }
									texture = "[GetLawIcon(Law.Self)]"
									background = {
										texture = "gfx/interface/component_tiles/laws_background_frame.dds"
										texture_density = 2
										spriteType = corneredstretched
										spriteBorder = { 0 0 }
										modify_texture = {
											texture = "[ResolutionGlue.GetBgCategoryColor]"
											blend_mode = multiply
										}
										modify_texture = {
											using = overlay_cloth_texture
											blend_mode = overlay
											alpha = 0.2
										}
										modify_texture = {
											using = color_black_texture
											blend_mode = overlay
											alpha = 0.3
										}
									}
								}
								vbox = {
									layoutpolicy_horizontal = expanding
									ignoreinvisible = yes
									text_single = {
										layoutpolicy_horizontal = expanding
										using = Font_Size_Small
										align = nobaseline|left
										default_format = "#yellow_titles"
										text = "[Law.GetName]"
									}
									hbox = {
										layoutpolicy_horizontal = expanding

										text_single = {
											autoresize = yes
											maximumsize = { 140 -1 }
											align = nobaseline|left
											fontsize = 13
											visible = "[IoSubheaderSelectMenu.Parent.GetInternationalOrganization.HasPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
											text = "[IoSubheaderSelectMenu.Parent.GetInternationalOrganization.GetPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self).GetNameWithNoTooltip]"
										}
										text_single = {
											align = nobaseline|left
											fontsize = 13
											visible = "[Not(IoSubheaderSelectMenu.Parent.GetInternationalOrganization.HasPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self))]"
											text = "NO_POLICY_SELECTED"
										}
										expand = {}

										text_single = {
											autoresize = yes
											maximumsize = { 140 -1 }
											align = nobaseline|left
											visible = "[IoSubheaderSelectMenu.Parent.GetInternationalOrganization.HasPolicyForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
											text = "[IoSubheaderSelectMenu.Parent.GetInternationalOrganization.GetPolicyImplementedDateStringForLaw(ResolutionGlue.GetTarget('target').GetLaw.Self)]"
										}
									}
								}
								
								expand = {}
							}
							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 5
								datamodel = "[Law.GetPoliciesDataModel]"
								item = {
									widget = {
										layoutpolicy_horizontal = expanding
										size = { -1 40 }
										card_list_action_button = {
											size = { 96% 100% }
											visible = "[Not(StringIsEmpty(ResolutionGlue.GetEnactResolution.GetKey))]"
											blockoverride "texture" {
												gfxtype = framedbuttongfx
												effectname = "NoHighlight"
												upframe = 1
												overframe = 2
												downframe = 3
												disableframe = 4
												texture = "gfx/interface/buttons/list_card_button.dds"
												frame_grid = {4 1}
												spriteType = Corneredstretched
												spriteborder = { 0 0 }
												texture_density = 2
											}
											icon = {
												ignore_layout = yes
												size = {99% 97%}
												parentanchor = center
												block "law_unique_flavor_visible" {
													visible = "[Policy.GetLaw.IsUnique]"
												}
												texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
												texture_density = 2
												mirror = horizontal
												alpha = 0.1
												modify_texture = {
													texture = "[ResolutionGlue.GetBgCategoryColor]"
													texture_density = 2
													blend_mode = multiply
												}
											}
											title = "[Policy.GetNameWithNoTooltip]"
											enabled = "[UIAction.IsEnabled]"
											proposer = "[ResolutionGlue.GetProposer]"
											actor = "[IoSubheaderSelectMenu.Parent.GetPlayer]"
											left_click_and_hold_action = {
												action_name = "[ResolutionGlue.GetEnactResolution.GetKey]"
												parameter = {
													parameter_name = "recipient"
													parameter_value = "[IoSubheaderSelectMenu.Parent.GetInternationalOrganization]"
												}
												parameter = {
													parameter_name = "target"
													parameter_value = "[ResolutionGlue.GetTarget('target').GetLaw]"
												}
												parameter = {
													parameter_name = "vote"
													parameter_value = "[ResolutionGlue.GetTarget('target').GetLaw.GetPolicyAtIndex(PdxGuiWidget.GetIndexInDataModel)]"
												}
											}
											tooltipwidget = {
												datacontext = "[Policy]"
												using = action_tooltip_pop_out
												blockoverride "title_icon_texture" {
													texture = "[GetLawIcon(Policy.GetLaw)]"
												}
												blockoverride "concept_link" {
													text = "[policy|e]"
												}
											}
											
											hbox = {
												margin = { 4 0 }
												spacing = 10
												layoutpolicy_horizontal = expanding
												widget = {
													size = { 36 36 }
													background = {
														texture = "gfx/interface/component_tiles/laws_background_frame.dds"
														texture_density = 2
														spriteType = corneredstretched
														spriteBorder = { 0 0 }
														modify_texture = {
															texture = "[ResolutionGlue.GetBgCategoryColor]"
															blend_mode = multiply
														}
														modify_texture = {
															using = overlay_cloth_texture
															blend_mode = overlay
															alpha = 0.2
														}
														modify_texture = {
															using = color_black_texture
															blend_mode = overlay
															alpha = 0.3
														}
													}
													icon = {
														size = { 90% 90% }
														parentanchor = center
														texture = "[GetLawIcon(Policy.GetLaw.Self)]"
														background = {
															visible = "[And(IoSubheaderSelectMenu.Parent.GetInternationalOrganization.HasPolicyForLaw(Policy.GetLaw.Self), ObjectsEqual(IoSubheaderSelectMenu.Parent.GetInternationalOrganization.GetPolicyForLaw(Policy.GetLaw.Self), Policy.Self))]"
															texture = "gfx/interface/advance/advances_glow/advances_glow_yellow.dds"
															texture_density = 2
															alpha = 0.7
															margin = { 5 5 }
														}
													}
												}
				
												hbox = {
													layoutpolicy_horizontal = expanding
													ignoreinvisible = yes
													text_single = {
														layoutpolicy_horizontal = expanding
														using = Font_Size_Small
														align = nobaseline|left
														default_format = "#yellow_titles"
														block "law_title" {
															text = "[Policy.GetNameWithNoTooltip]"
														}
													}
													hbox = {
														widget = {
															size = { 31 31 }
															using = bg_circle
															visible = "[And3(ObjectsEqual(InternationalOrganizationsView.GetInternationalOrganization.GetParliament.GetLawDebatePassPolicy, Policy.Self), ResolutionGlue.GetOwner.ShouldDisplayProgressForLaw(Policy.GetLaw.Self), ObjectsEqual(ResolutionGlue.GetHighestVote.GetVoteObject, Policy.Self))]"
															piechart = {
																size = { 100% 100% }
																parentanchor = center
																using = piechart_angles
																icon = {
																	parentanchor = center
																	size = { 70% 70% }
																	texture = "gfx/interface/icons/situations/_default.dds"
																	texture_density = 2
																}
																pieslice = {
																	texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																	value = "[FixedPointToFloat(ResolutionGlue.GetProgressToDeadline)]"
																	using = color_value_progress_blue
																}
																pieslice = {
																	texture = "gfx/interface/pie_charts/pie_chart_alpha_80.dds"
																	value = "[Subtract_float('(float)100.0', FixedPointToFloat(ResolutionGlue.GetProgressToDeadline))]"
																	using = color_value_progress_gray
																}
																using = bg_circle_piechart
															}
														}
														widget = {
															size = { 31 31 }
															using = bg_circle
															visible = "[And(ObjectsEqual(InternationalOrganizationsView.GetInternationalOrganization.GetParliament.GetLawDebatePassPolicy, Policy.Self), Or(ResolutionGlue.EnactResolutionIsActive, ResolutionGlue.RepealResolutionIsActive))]"
															piechart = {
