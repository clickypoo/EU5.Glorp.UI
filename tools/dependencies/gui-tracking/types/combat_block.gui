								}
							}

							# RESERVES
							reserves_status = {
								datacontext = "[CombatSide.GetReserves]"
							}
						}
					}
				}
			}

			# DEFENDER STATISTICS
			combat_side_statistics = {
				datacontext = "[Combat.GetDefender]"

				blockoverride "combat_side_name" { 
					text = "[defender|e]"
				}
			}
		}
	}
