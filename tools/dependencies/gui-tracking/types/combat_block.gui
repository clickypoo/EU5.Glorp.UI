											parentanchor = center
											position = {0 5}
											visible = "[GreaterThan_int32(CombatSide.GetFlankFrame(Combat.GetAttacker, 'right'), '(int32)5')]"
											texture = "gfx/interface/icons/outliner/unit_combat.dds"
											texture_density = 2
