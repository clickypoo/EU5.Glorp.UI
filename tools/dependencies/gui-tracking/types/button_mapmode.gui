# vanilla: in_game/gui/hud_bot.gui
# mod: in_game/gui/glorpUI_hud_bot.gui

	type button_mapmode = button {
		block "button_size" {
			size = { 40 40 } # GlorpUI: Smaller Mapmode Buttons
		}

		block "button_mapmode_actions"
		{
			using = button_mapmode_actions
		}

		tooltipmeta = {
			texture = "[MapMode.GetIcon]"
		}

		using = paper_card_texture
		modify_texture = {
			using = color_brown_leather_texture
			alpha = 0.3
		}

        # GlorpUI: Coloured Mapmode Buttons
        modify_texture = {
            visible = "[And(EqualTo_string(MapMode.GetMapModeCategory, 'Government'), Not(Player.MakeScope.GetVariable('disableColouredMapmodeButtons').IsSet))]"
            using = color_purple_texture

            block "mapmode_color_modify_texture_setup" {
                blend_mode = normal
                alpha = 0.8
            }
        }
        modify_texture = {
            visible = "[And(EqualTo_string(MapMode.GetMapModeCategory, 'Economy'), Not(Player.MakeScope.GetVariable('disableColouredMapmodeButtons').IsSet))]"
            using = color_mid_yellow_texture

            block "mapmode_color_modify_texture_setup" {
                blend_mode = normal
                alpha = 0.8
            }
        }
        modify_texture = {
            visible = "[And(EqualTo_string(MapMode.GetMapModeCategory, 'Diplomacy'), Not(Player.MakeScope.GetVariable('disableColouredMapmodeButtons').IsSet))]"
            using = color_diplomacy_texture

            block "mapmode_color_modify_texture_setup" {
                blend_mode = normal
                alpha = 0.8
            }
        }
        modify_texture = {
            visible = "[And(EqualTo_string(MapMode.GetMapModeCategory, 'Population'), Not(Player.MakeScope.GetVariable('disableColouredMapmodeButtons').IsSet))]"
            using = color_society_texture

            block "mapmode_color_modify_texture_setup" {
                blend_mode = normal
                alpha = 1
            }
        }
        modify_texture = {
            visible = "[And(EqualTo_string(MapMode.GetMapModeCategory, 'Demography'), Not(Player.MakeScope.GetVariable('disableColouredMapmodeButtons').IsSet))]"
            using = color_dark_turquoise_texture

            block "mapmode_color_modify_texture_setup" {
                blend_mode = normal
                alpha = 0.6
            }
        }
        modify_texture = {
            visible = "[And(EqualTo_string(MapMode.GetMapModeCategory, 'Military'), Not(Player.MakeScope.GetVariable('disableColouredMapmodeButtons').IsSet))]"
            using = color_military_texture

            block "mapmode_color_modify_texture_setup" {
                blend_mode = normal
                alpha = 0.8
            }
        }
        modify_texture = {
            visible = "[And(EqualTo_string(MapMode.GetMapModeCategory, 'Geopolitics'), Not(Player.MakeScope.GetVariable('disableColouredMapmodeButtons').IsSet))]"
            using = color_geopolitics_texture

            block "mapmode_color_modify_texture_setup" {
                blend_mode = normal
                alpha = 0.8
            }
        }
        modify_texture = {
            visible = "[And(EqualTo_string(MapMode.GetMapModeCategory, 'Geography'), Not(Player.MakeScope.GetVariable('disableColouredMapmodeButtons').IsSet))]"
            using = color_default_brown_texture

            block "mapmode_color_modify_texture_setup" {
                blend_mode = normal
                alpha = 0.8
            }
        }
        modify_texture = {
            visible = "[And(EqualTo_string(MapMode.GetMapModeCategory, 'Debug'), Not(Player.MakeScope.GetVariable('disableColouredMapmodeButtons').IsSet))]"
            using = color_brown_leather_texture

            block "mapmode_color_modify_texture_setup" {
                blend_mode = normal
                alpha = 0.8
            }
        }

		modify_texture = {
			using = color_raw_paper_texture
			alpha = 0.2
		}

		modify_texture = { visible = "[Player.MakeScope.GetVariable('disableColouredMapmodeButtons').IsSet]" using = color_paper_texture } # GlorpUI: added visible
		modify_texture = { using = overlay_paper_03 }

		glow = {
			name = "drop_shadow"
			glow_radius = 3
			color = {0.0 0.0 0.0 1.0}
			alpha = 1
		}

		button_icon_map_square = { visible = "[Player.MakeScope.GetVariable('disableColouredMapmodeButtons').IsSet]" } # GlorpUI: added visible
		icon = { # GlorpUI: Recolour Dashed Padding
			visible = "[Not(Player.MakeScope.GetVariable('disableColouredMapmodeButtons').IsSet)]"
			size = { 100% 100% }
			texture = "gfx/interface/buttons/map_modes/map_texture_square.dds"
		}

		icon = {
			size = { 28 28 } # GlorpUI: 34->28
			parentanchor = center
			texture = "[MapMode.GetIcon]"
			glow = {
				name = "drop_shadow"
				glow_radius = 2
				color = {0.0 0.0 0.0 1.0}
				alpha = 0.5
			}
		}
	}
