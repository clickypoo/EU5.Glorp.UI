# vanilla: in_game/gui/hud_bot.gui
# mod: in_game/gui/glorpUI_hud_bot.gui

	type button_mapmode = button {
		size = { 40 40 }

		block "button_mapmode_actions"
		{
			using = button_mapmode_actions
		}

		tooltipmeta = {
			texture = "[MapMode.GetIcon]"
		}

		using = paper_card_texture
		modify_texture = {
			using = color_brown_leather_texture
			alpha = 0.3
		}

		modify_texture = {
			using = color_raw_paper_texture
			alpha = 0.2
		}

		modify_texture = { using = color_paper_texture }
		modify_texture = { using = overlay_paper_03 }

		glow = {
			name = "drop_shadow"
			glow_radius = 3
			color = {0.0 0.0 0.0 1.0}
			alpha = 1
		}

		button_icon_map_square = {}

		icon = {
			size = { 34 34 }
			parentanchor = center
			texture = "[MapMode.GetIcon]"
			glow = {
				name = "drop_shadow"
				glow_radius = 2
				color = {0.0 0.0 0.0 1.0}
				alpha = 0.5
			}
		}
	}
