# vanilla: in_game/gui/shared/cabinet_cards.gui
# mod: in_game/gui/shared/glorpUI_cabinet_cards.gui

	type cabinet_character_button = card_header_button_cabinet {

		layoutpolicy_horizontal = expanding
		size = { -1 31 }
		using = button_action
		using = bg_paper_card
		using = bg_card_header_01
		
		blockoverride "header_color" {
			using = color_government_texture
		}

		using = header_button_texture
		spriteborder = { 10 10 }
		
		hbox = {
			using = layoutpolicy_expanding
			margin_left = 5

			icon = {
				size = { 25 25 }
				texture = "gfx/interface/buttons/estate_privileges/ep_plus.dds"
				visible = "[Not(Cabinet.IsCharacterSet)]"
				modify_texture = {
					using = color_new_gold_texture
					blend_mode = add
				}
				glow = {
					name = "drop_shadow"
					glow_radius = 3
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.8
				}
			}
		
			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = -2
				margin_left = 0
                margin_right = 10
                
                icon = {
                    visible = "[LateralView.Vars.Exists( 'cabinet_compacted' )]"
                    block "estate_icon" {}
                    block "character_frame_estate_visible" {
                        visible = "[And(Cabinet.IsCharacterSet, LateralView.Vars.Exists( 'cabinet_compacted' ))]"
                    }
                    block "character_frame_estate_size" {
                        size = { 30 30 }
                    }
                    texture = "[GetEstateIcon(Cabinet.GetCharacter.GetEstateType)]"
                    datacontext = "[Cabinet.GetCharacter.GetCourtCountry.GetGovernment.GetEstate(Cabinet.GetCharacter.GetEstateType)]"
                    datacontext = "[Cabinet.GetCharacter.GetCourtCountry]"
                    tooltipwidget = {
                        using = Estate_tooltip
                    }
                }
				
				text_single = {
					layoutpolicy_horizontal = expanding
					size = { -1 25 }
					autoresize = no
					elide = right
					align = nobaseline
					using = Font_Type_Flavor
					text = "[Cabinet.GetCharacter.GetCourtCountry.Custom('GetHeadOfCabinetName')] [Cabinet.GetCharacter.GetNameToFitWithNoTooltip(Select_int32(LateralView.Vars.Exists( 'cabinet_compacted' ), '(int32)20', '(int32)-1'), '(bool)no')], [Cabinet.GetCharacter.GetAgeInYears]"
					visible = "[And(Cabinet.IsCharacterSet, Cabinet.GetCharacter.IsHeadOfCabinet)]"
				}
				
				text_single = {
					layoutpolicy_horizontal = expanding
					size = { -1 25 }
					autoresize = no
					elide = right
					align = nobaseline
					using = Font_Type_Flavor
					text = "[Cabinet.GetCharacter.GetNameToFitWithNoTooltip(Select_int32(LateralView.Vars.Exists( 'cabinet_compacted' ), '(int32)25', '(int32)-1'), '(bool)no')], [Cabinet.GetCharacter.GetAgeInYears]"
					visible = "[And(Cabinet.IsCharacterSet, Not(Cabinet.GetCharacter.IsHeadOfCabinet))]"
				}
	
				text_single = {
					align = nobaseline
					using = Font_Type_Flavor
					text = "ADD_CABINET_CHARACTER"
					visible = "[Not(Cabinet.IsCharacterSet)]"
				}

				hbox = {
					visible = "[Cabinet.IsCharacterSet]"
					margin = { 5 0 }
					datamodel = "[Cabinet.GetCharacter.GetTraitsByCategory('cabinet')]"
					
					item = {
						widget = {
							size = { 24 24 }
							using = trait_item
							blockoverride "trait_item_size" {
								size = { 24 24 }
							}
							blockoverride "trait_positive_negative_overlay" {
								allow_outside = yes
								icon = {
									ignore_layout = yes
									size = { 20 20 }
									position = { 10 10 }
									texture = "gfx/interface/buttons/flats/plus.dds"
									visible = "[Not(Trait.IsBad)]"
									modify_texture = {
										blend_mode = colordodge
										using = color_light_green_texture
									}
								}
								icon = {
									ignore_layout = yes
									size = { 14 16 }
									position = { 13 11 }
									texture = "gfx/interface/buttons/flats/minus.dds"
									visible = "[Trait.IsBad]"
									modify_texture = {
										blend_mode = colordodge
										using = color_red_texture
									}
								}
							}
						}
					}
				}
			}
		}
	}
