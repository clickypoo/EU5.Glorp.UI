# vanilla: in_game/gui/map_markers.gui
# mod: in_game/gui/map_markers.gui

	type unit_marker_item_units = widget {
		layoutpolicy_horizontal = expanding
		size = {-1 15 }
		hbox = {
			layoutpolicy_horizontal = expanding
			margin_left = 5
			margin_right = 15

			overlappingitembox = {
				visible = "[GreaterThan_int32(GetDataModelSize(UnitMarkerItem.GetAllUnits), '(int32)1')]"

				layoutpolicy_horizontal = expanding
				size = { -1 15 }
				spacing = 5
				autoresize = yes
				max_width = 100

				ignoreinvisible = yes
				alwaystransparent = no
				using = unit_marker_item_unit_banners
			}
		}
	}
