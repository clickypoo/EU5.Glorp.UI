# vanilla: in_game/gui/hud_bot.gui
# mod: in_game/gui/glorpUI_hud_bot.gui

	type button_mapmode_category = hbox {
		layoutpolicy_horizontal = expanding

		margin_right = 5
		spacing = 10

		block "button_mapmode_category_setup"  {}

		widget = {
			size = { 100% 100% }
			ignore_layout = yes

			button = {
				size = { 90% 90% } # GlorpUI: {100% 80%} -> {90% 90%}
				parentanchor = left|vcenter # GlorpUI: center -> left|vcenter

				using = button_mapmode_actions
				block "button_mapmode_actions_extra" {
					action_tooltip = {
						click_type = right
						on_action = "[PdxGuiWidget.ToggleContextMenu]"
						title = "MAPMODE_SLOT_MENU"
					}

					contextmenu_widget = {
						using = mapmode_slot_pick_menu
					}
				}

				using = button_outliner_category_texture # GlorpUI: banner -> outliner goldframe
				using = mapmode_color

				icon = {
					mirror = horizontal
					size = { 100% 100% }
					texture = "gfx/interface/buttons/outliner/outliner_goldframe.dds"
					texture_density = 2
					spriteType = corneredstretched
				}
			}
		}

		icon = {
			size = { 35 35 } # GlorpUI: 40->35
			using = paper_card_texture
			modify_texture = { using = color_brown_leather_texture alpha = 0.3 }
			modify_texture = { using = color_raw_paper_texture alpha = 0.2 }
			modify_texture = { using = color_paper_texture }
			modify_texture = { using = overlay_paper_03 }
			glow = {
				name = "drop_shadow"
				glow_radius = 3
				color = {0.0 0.0 0.0 1.0}
				alpha = 1
			}

			button_icon_map_square = {}

			icon = {
				size = { 30 30 }
				parentanchor = center
				texture = "[MapMode.GetIcon]"
				glow = {
					name = "drop_shadow"
					glow_radius = 2
					color = {0.0 0.0 0.0 1.0}
					alpha = 0.5
				}
			}
		}

		text_single = {
			autoresize = yes
			minimumsize = { 80 -1 }
			default_format = "#yellow_titles"
			text = "[MapMode.GetName]"
		}

		expand = {}

		block "button_mapmode_right" {
			# GlorpUI: slot pick button
			button_pin_alt = {
				size = { 27 27 }
				# TODO: Check if the mapmode has been pinned in any of the slots.
				# datamodel = "[DataModelRepeatedItem(GetDataModelSize(GetMapModesSlots))]"
				# item = {
				# 	datacontext_from_model = {
				# 		datamodel = "[GetMapModesSlots]"
				# 		index = "[Subtract_int32(GetDataModelSize(GetMapModesSlots), Subtract_int32(PdxGuiWidget.GetIndexInDataModel, '(int32)-1'))]"
				# 	}
				# 	visible = "[MapMode.IsInSlot(MapModeSlot.GetSlotIndex)]"
				# }
				# frame = "[Select_int32(Player.MakeScope.GetVariable('MapmodePinned').IsSet, '(int32)2', '(int32)1')]"

				action_tooltip = {
					click_type = left
					on_action = "[PdxGuiWidget.ToggleContextMenu]"
					title = "MAPMODE_SLOT_MENU"
				}
				contextmenu_widget = {
					using = mapmode_slot_pick_menu
				}
				tooltipwidget = {
					SimpleContextualTooltipType = {
						blockoverride "title_icon_texture" { texture = "[MapMode.GetIcon]" }
						lowpriotextcontext = "[MapMode.GetTooltip]"
					}
				}
			}
		}
	}
