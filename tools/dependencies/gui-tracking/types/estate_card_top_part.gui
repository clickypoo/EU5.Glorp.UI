		# 	icon = {
		# 		size = { 25 40 }
		# 		parentanchor = right
		# 		position = {15 0}
		# 		visible = "[ObjectsEqual(Player.GetGovernment.GetEstateFromKey('crown_estate').GetType, Estate.GetType)]"
